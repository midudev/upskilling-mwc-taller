---
import { Font } from 'astro:assets';
import PixelIcon from '../components/PixelIcon.astro';
import TokenGate from '../components/TokenGate.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'Webs listas con la IA';
const { title, description = 'Taller práctico: MCP UI, WebMCP, Jev e IA local en el navegador. Upskilling Week Barcelona.' } =
  Astro.props;

const REPO = 'https://github.com/midudev/upskilling-mwc-taller';

const links = [
  { href: '/', text: 'Inicio' },
  { href: '/retos', text: 'Retos' },
  { href: '/directo', text: 'Directo' },
  { href: '/slides', text: 'Slides' },
];

// Con build.format: 'file' el pathname llega como /index.html o /agenda.html
const path = Astro.url.pathname.replace(/(\/index)?\.html$|\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Lo primero del <head>: los preload de las fuentes arrancan antes que nada */}
    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-sans" preload />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · ${SITE}` : SITE}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">mwc<span class="accent">/</span>taller</a>
      <nav aria-label="Principal">
        {
          links.map(({ href, text }) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {text}
            </a>
          ))
        }
        <button type="button" class="token-nav-btn" data-abrir-token data-has-token="false" title="Introducir token del taller">
          <PixelIcon name="key" size={14} />
          <span>Token</span>
          <span class="token-estado" data-token-estado aria-hidden="true">·</span>
        </button>
        <a class="repo-link" href={REPO} target="_blank" rel="noopener" aria-label="Código del taller en GitHub" title="Código del taller en GitHub">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
          </svg>
        </a>
      </nav>
    </header>

    <TokenGate mode="bar" />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>Upskilling Week Barcelona · Mobile World Capital</span>
      <span>Miguel Ángel Durán · <a href="https://midu.dev">midudev</a></span>
    </footer>
  </body>
</html>

<style>
  .site-header,
  main,
  .site-footer {
    width: min(100% - 3rem, 860px);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
  }

  .brand {
    font-family: var(--pixel);
    font-size: 1.15rem;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--fg);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    font-size: 0.87rem;
  }

  .token-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }

  .token-nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .token-nav-btn[data-has-token='false'] {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .token-nav-btn[data-has-token='false'] .token-estado {
    color: var(--accent);
    font-weight: 700;
  }

  .token-nav-btn[data-has-token='true'] {
    color: var(--muted);
  }

  .token-nav-btn[data-has-token='true'] .token-estado {
    color: #3fdc6f;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
  }

  nav a[aria-current='page']::before {
    content: '▪ ';
    color: var(--accent);
  }

  main {
    padding-block: 3rem 5rem;
    min-height: 70vh;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
