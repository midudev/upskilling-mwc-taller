---
// Layout de las demos en directo que vienen de la charla (Mario, Camp Nou): pantalla completa,
// sin la cabecera de la web. El token del taller se lee de localStorage y se pide una vez si falta.
import { Font } from 'astro:assets';
import TokenGate from '../components/TokenGate.astro';

interface Props {
  title?: string;
  description?: string;
  /** La web del Camp Nou no usa el tema negro */
  light?: boolean;
  icon?: string;
  /** Si la demo llama a APIs protegidas, pide el token automáticamente si no está guardado */
  requiereToken?: boolean;
}

const {
  title = 'En directo',
  description = 'Demos en directo del taller',
  light = false,
  icon = '/favicon.svg',
  requiereToken = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={light ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-pixel" preload />
    <meta name="description" content={description} />
    <meta name="theme-color" content={light ? '#fff' : '#000'} />
    <link rel="icon" href={icon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {requiereToken && <TokenGate mode="modal" autoOpen />}
  </body>
</html>

<style is:global>
  :root {
    --red: #ff313c;
    --yellow: #ffb300;
    --teal: #00a5a1;
    --fg: #fafafa;
    --muted: #737373;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: #000;
    color: var(--fg);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
  }

  [data-theme='light'] {
    color-scheme: light;
  }

  [data-theme='light'] body {
    background: #fff;
    color: #111;
  }

  ::selection {
    background: var(--red);
    color: #000;
  }
</style>
