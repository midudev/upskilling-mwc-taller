---
// El editor de un reto: los archivos a la izquierda, el resultado a la derecha y los pasos debajo.
// Todo se ejecuta en el navegador (src/lib/retos/editor.ts): no hay que instalar nada.
import type { ConfigDelEditor } from '../../lib/retos/tipos';

interface Props {
  config: ConfigDelEditor;
  pasos: { titulo: string; archivo: string; todo: string; pistas: string[] }[];
  minutos: number;
}

const { config, pasos, minutos } = Astro.props;
const conAgente = config.paneles.includes('agente');
const visibles = config.archivos.filter((a) => !a.oculto).sort((a, b) => Number(b.editable) - Number(a.editable));
// Las pistas admiten `código` entre comillas invertidas
const trozosDe = (pista: string) => pista.split('`').map((texto, i) => ({ texto, codigo: i % 2 === 1 }));
// Evita que un "</script>" dentro de los archivos cierre la etiqueta antes de tiempo
const json = JSON.stringify(config).replaceAll('</', '<\\/');
---

<section class="editor" data-editor aria-label="Editor del reto">
  <script type="application/json" data-config set:html={json} />

  <div class="barra">
    <div class="pestanas" role="tablist" aria-label="Archivos" data-pestanas>
      {visibles.map((a) => <button type="button" role="tab" class={a.editable ? 'editable' : 'lectura'}>{a.ruta}</button>)}
    </div>
    <div class="acciones">
      <button type="button" class="principal" data-accion="ejecutar" title="Ejecutar (⌘S o Ctrl+S)">
        ▶ Ejecutar <kbd class="atajo"><kbd data-tecla-mod>⌘</kbd><kbd>S</kbd></kbd>
      </button>
      <button type="button" data-accion="solucion" aria-pressed="false">Ver solución</button>
      <button type="button" data-accion="reiniciar" title="Vuelve al código del principio">Reiniciar</button>
      <button type="button" data-accion="ampliar" class="icono" aria-pressed="false" aria-label="Pantalla completa" title="Pantalla completa">
        <svg class="ampliar" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M12 3h5v5M8 17H3v-5M17 3l-5.5 5.5M3 17l5.5-5.5"></path></svg
        >
        <svg class="reducir" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M16 8h-4V4M4 12h4v4M12 8l5-5M8 12l-5 5"></path></svg
        >
      </button>
    </div>
  </div>

  <div class="cuerpo" data-cuerpo>
    <div class="lado-codigo" data-lado="codigo">
      <button type="button" class="plegado-etiqueta" data-restaurar="codigo" title="Mostrar código">
        <span class="plegado-icono" aria-hidden="true">›</span>
        <span class="plegado-texto">Código</span>
      </button>
      <p class="aviso-solucion" data-aviso-solucion hidden>
        <span>Estás viendo la <strong>solución</strong>: en verde, lo que va en cada hueco.</span>
        <button type="button" data-accion="copiar">Copiar a tus huecos</button>
      </p>
      <p class="aviso-lectura" data-aviso-lectura hidden>
        <span class="candado" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6"
            ><rect x="3" y="7" width="10" height="7.5" rx="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path></svg
          >
        </span>
        <span><strong>Solo lectura.</strong> Está aquí para que veas el contexto. Lo que completas está en <span data-editables></span>.</span>
      </p>
      <div class="codigo" data-codigo></div>
      <p class="aviso-bloqueo" data-aviso-bloqueo role="status" hidden>
        Este código ya está hecho: escribe solo en los huecos <span class="muestra-hueco">✎ amarillos</span>
      </p>
    </div>

    <div
      class="divisor"
      data-divisor
      role="separator"
      aria-orientation="vertical"
      aria-label="Redimensionar código y demo"
      tabindex="0"
      title="Arrastra para redimensionar (doble clic para centrar)"
    ></div>

    <div class="lado-salida" data-lado="salida">
      <button type="button" class="plegado-etiqueta" data-restaurar="salida" title="Mostrar demo">
        <span class="plegado-icono" aria-hidden="true">‹</span>
        <span class="plegado-texto">Demo</span>
      </button>
      <div class="pestanas-salida" role="tablist" aria-label="Salida">
        <button type="button" role="tab" data-salida="resultado" aria-selected="true">Resultado</button>
        <button type="button" role="tab" data-salida="consola" aria-selected="false">
          Consola <span class="contador" data-contador-consola hidden>0</span>
        </button>
        <span class="en-solucion-etiqueta">solución</span>
      </div>

      <div class="panel panel-resultado" data-panel="resultado">
        <div class="vista-contenedor">
          <div class="vista" data-vista></div>
          {
            conAgente && (
              <button
                type="button"
                class="chat-fab"
                data-chat-fab
                aria-label="Abrir el asistente WebMCP"
                aria-expanded="false"
                title="Hablar con el asistente WebMCP"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
                <span>Asistente</span>
                <span class="chat-fab-cuenta" data-chat-cuenta data-activo="false">0</span>
              </button>
            )
          }
        </div>
        {
          conAgente && (
            <section class="chat-panel" data-chat-panel role="dialog" aria-label="Asistente WebMCP de la tienda" hidden>
              <header class="chat-cabecera">
                <div class="chat-icono-cabecera" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                  </svg>
                </div>
                <div class="chat-titulo">
                  <p class="chat-nombre">
                    Asistente <span class="chat-badge">WebMCP</span>
                  </p>
                  <p class="chat-estado" data-chat-estado data-activo="false" data-ocupado="false">Sin herramientas WebMCP</p>
                </div>
                <div class="chat-acciones">
                  <button
                    type="button"
                    class="chat-icono-btn chat-reiniciar"
                    data-chat-reiniciar
                    aria-label="Reiniciar conversación"
                    title="Reiniciar conversación"
                  >
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                      <path d="M3 3v5h5" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="chat-icono-btn chat-cerrar"
                    data-chat-cerrar
                    aria-label="Cerrar asistente"
                    title="Cerrar (Esc)"
                  >
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </header>
              <div class="chat-mensajes" data-chat-mensajes></div>
              <footer class="chat-pie">
                <div class="chat-sugerencias" data-chat-sugerencias></div>
                <form class="chat-form" data-chat-form>
                  <textarea
                    rows="1"
                    data-chat-input
                    aria-label="Mensaje para el asistente"
                    placeholder="Pide algo a la tienda…"
                  ></textarea>
                  <button type="submit" class="chat-enviar" data-chat-enviar>Enviar</button>
                </form>
              </footer>
            </section>
          )
        }
        <button type="button" class="error-ejecucion" data-error hidden></button>
        {
          conAgente && (
            <details class="agente" open>
              <summary>
                Agente <span class="muted">· lo que ve un agente del navegador en tu tienda</span>
              </summary>
              <div data-agente />
            </details>
          )
        }
      </div>
      <ol class="panel consola" data-panel="consola" data-consola hidden></ol>
    </div>
  </div>

  <div class="pasos">
    <p class="pasos-cabecera">
      <span class="label">Pasos · {minutos} min</span>
      <span class="progreso" data-progreso>0/{pasos.length}</span>
      <span class="hecho">¡Reto completado!</span>
      <span class="muted ayuda">Rellena los <code>___</code> de cada hueco y ejecuta: los pasos se comprueban solos. Si te atascas, pide una pista.</span>
    </p>
    <ol class="lista-pasos">
      {
        pasos.map((paso, indice) => (
          <li data-paso data-archivo={paso.archivo} data-todo={paso.todo}>
            <button type="button" class="ir" data-ir title="Ir a su hueco">
              <span class="estado" aria-hidden="true" />
              <span class="numero">{indice + 1}</span>
              <span class="titulo">{paso.titulo}</span>
              <code class="donde">
                {paso.archivo} · {paso.todo}
              </code>
            </button>
            <p class="mensaje" />
            <ul class="pistas" data-pistas>
              {
                paso.pistas.map((pista) => (
                  <li hidden>
                    {trozosDe(pista).map((trozo) => (trozo.codigo ? <code>{trozo.texto}</code> : trozo.texto))}
                  </li>
                ))
              }
            </ul>
            <div class="botones-pista">
              <button type="button" data-pista>Pista</button>
              <button type="button" data-rellenar hidden title="Escribe la solución en el hueco (Ctrl+Z para deshacer)">
                Rellenar con la solución
              </button>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="pruebas" data-pruebas aria-hidden="true"></div>
</section>

<script>
  import { montarEditor } from '../../lib/retos/editor';

  for (const $editor of document.querySelectorAll<HTMLElement>('[data-editor]')) {
    montarEditor($editor).catch((error) => {
      console.error(error);
      $editor.insertAdjacentHTML('afterbegin', `<p class="fallo">No se ha podido cargar el editor: ${error.message}</p>`);
    });
  }
</script>

<style is:global>
  .editor {
    /* Huecos por rellenar: amarillo. Hechos: verde */
    --hueco: #ffb000;
    --ok: #3fdc6f;
    /* Más ancho que el texto de la página: sale del contenedor de 860 px */
    --ancho: min(100vw - 2rem, 1480px);
    position: relative;
    width: var(--ancho);
    margin-inline: calc((100% - var(--ancho)) / 2);
    margin-block: 2rem 3rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    overflow: hidden;
  }

  /* Barras de scroll finas y sin fondo, como las de macOS */
  .editor,
  .editor * {
    scrollbar-width: thin;
    scrollbar-color: #ffffff38 transparent;
  }

  @supports not (scrollbar-color: auto) {
    .editor ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
      background: transparent;
    }

    .editor ::-webkit-scrollbar-track,
    .editor ::-webkit-scrollbar-corner {
      background: transparent;
    }

    .editor ::-webkit-scrollbar-thumb {
      border: 2px solid transparent;
      border-radius: 999px;
      background: #ffffff38 padding-box;
    }

    .editor ::-webkit-scrollbar-thumb:hover {
      background-color: #ffffff60;
    }
  }

  html.con-editor-ampliado {
    overflow: hidden;
  }

  .editor.ampliado {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }

  .editor button {
    font: inherit;
    font-size: 0.8rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .editor button:hover:not(:disabled) {
    border-color: var(--muted);
  }

  .editor button.principal {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .editor button.principal:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .editor.sin-ejecutar button.principal {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .editor button.peligro {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* El atajo: dos teclas pequeñas dentro del botón */
  .editor .atajo {
    display: inline-flex;
    gap: 0.2rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .editor .atajo kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-bottom-width: 2px;
    border-radius: 4px;
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    opacity: 0.75;
  }

  .editor .atajo kbd[data-tecla-mod] {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }

  /* ── Barra: pestañas de archivos y acciones ── */

  .editor .barra {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .editor .pestanas {
    display: flex;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .editor .pestanas button {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0.95rem;
    border: 0;
    border-right: 1px solid var(--line);
    border-radius: 0;
    color: var(--muted);
  }

  /* Los archivos que se completan: en claro y con el lápiz de los huecos */
  .editor .pestanas button.editable {
    color: var(--fg);
  }

  .editor .pestanas button[aria-selected='true'] {
    background: var(--bg);
    box-shadow: inset 0 2px 0 var(--hueco);
  }

  .editor .pestanas .icono-pestana {
    display: inline-flex;
    width: 0.9rem;
    justify-content: center;
    color: var(--hueco);
  }

  .editor .pestanas button.terminado .icono-pestana {
    color: var(--ok);
  }

  .editor .pestanas .cambiado {
    color: var(--hueco);
  }

  /* Los de solo lectura: apagados, en cursiva y con candado */
  .editor .pestanas button.lectura {
    color: #6b6b6b;
    font-style: italic;
    background: #0d0d0d;
  }

  .editor .pestanas button.lectura .icono-pestana {
    color: #5c5c5c;
  }

  .editor .pestanas button.lectura:hover {
    color: var(--muted);
  }

  .editor .pestanas button.lectura[aria-selected='true'] {
    color: var(--muted);
    background: #0b0b0b;
    box-shadow: inset 0 2px 0 #5c5c5c;
  }

  .editor .acciones {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    flex-shrink: 0;
  }

  .editor .acciones button {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
  }

  .editor .icono {
    justify-content: center;
    min-width: 2.4rem;
    padding-inline: 0.55rem;
  }

  .editor .icono svg {
    display: block;
  }

  .editor .icono[aria-pressed='true'] .ampliar,
  .editor .icono[aria-pressed='false'] .reducir {
    display: none;
  }

  /* ── Cuerpo: código | resultado ── */

  .editor .cuerpo {
    display: grid;
    grid-template-columns: var(--col-codigo, minmax(0, 1.05fr)) 9px var(--col-salida, minmax(0, 1fr));
    /* Que el editor y los pasos quepan a la vez en la pantalla */
    height: clamp(420px, calc(100vh - 220px), 860px);
  }

  .editor.redimensionando {
    user-select: none;
    cursor: col-resize;
  }

  .editor.redimensionando iframe {
    pointer-events: none;
  }

  .editor.ampliado .cuerpo {
    flex: 1;
    height: auto;
    min-height: 0;
  }

  .editor .divisor {
    position: relative;
    cursor: col-resize;
    background: var(--surface);
    border-inline: 1px solid var(--line);
    touch-action: none;
    transition: background 0.15s;
  }

  .editor .divisor::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3px;
    height: 32px;
    border-radius: 999px;
    background: var(--line);
    transition: background 0.15s, height 0.15s;
  }

  .editor .divisor:hover,
  .editor .divisor:focus-visible,
  .editor.redimensionando .divisor {
    background: #1a1a1a;
    outline: none;
  }

  .editor .divisor:hover::after,
  .editor .divisor:focus-visible::after,
  .editor.redimensionando .divisor::after {
    height: 48px;
    background: var(--hueco);
  }

  .editor .plegado-etiqueta {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 100%;
    padding: 0.75rem 0;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    color: var(--muted);
  }

  .editor .plegado-etiqueta:hover {
    color: var(--fg);
    background: #1a1a1a;
  }

  .editor .plegado-icono {
    font-size: 1rem;
    line-height: 1;
    color: var(--hueco);
  }

  .editor .plegado-texto {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--pixel);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .editor .cuerpo[data-plegado='codigo'] .lado-codigo > :not(.plegado-etiqueta),
  .editor .cuerpo[data-plegado='salida'] .lado-salida > :not(.plegado-etiqueta) {
    display: none;
  }

  .editor .cuerpo[data-plegado='codigo'] .lado-codigo > .plegado-etiqueta,
  .editor .cuerpo[data-plegado='salida'] .lado-salida > .plegado-etiqueta {
    display: flex;
  }

  .editor .lado-codigo {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .editor .codigo {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--surface);
  }

  .editor .aviso-solucion[hidden],
  .editor .aviso-lectura[hidden],
  .editor .aviso-bloqueo[hidden] {
    display: none;
  }

  /* Un archivo de solo lectura: franja que lo dice y fondo más oscuro */
  .editor .aviso-lectura {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: #0b0b0b;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .editor .aviso-lectura strong {
    color: var(--fg);
  }

  .editor .aviso-lectura .candado {
    align-self: center;
    display: inline-flex;
  }

  .editor .aviso-lectura .enlace {
    padding: 0;
    border: 0;
    color: var(--hueco);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .editor.en-lectura .codigo,
  .editor.en-lectura .codigo .cm-editor,
  .editor.en-lectura .codigo .cm-gutters {
    background: #0b0b0b;
  }

  /* Si intentas escribir fuera de un hueco */
  .editor .aviso-bloqueo {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    z-index: 5;
    translate: -50% 0;
    padding: 0.5rem 0.85rem;
    border: 1px solid #ffb00066;
    border-radius: 6px;
    background: #1d1606;
    color: #ffd27a;
    font-size: 0.78rem;
    white-space: nowrap;
    box-shadow: 0 8px 24px #000a;
    pointer-events: none;
  }

  .editor .muestra-hueco {
    padding: 0 0.3rem;
    border-left: 2px solid var(--hueco);
    background: #ffb00026;
  }

  .editor .aviso-solucion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: #3fdc6f14;
    font-size: 0.8rem;
  }

  .editor.en-solucion .codigo {
    box-shadow: inset 2px 0 0 var(--ok);
  }

  .editor .lado-salida {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .editor .pestanas-salida {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .editor .pestanas-salida button {
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 0;
    color: var(--muted);
  }

  .editor .pestanas-salida button[aria-selected='true'] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--fg);
  }

  .editor .contador {
    display: inline-block;
    min-width: 1.3em;
    margin-left: 0.25rem;
    padding: 0 0.3em;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    text-align: center;
  }

  .editor .contador[hidden] {
    display: none;
  }

  .editor .en-solucion-etiqueta {
    display: none;
    margin-left: auto;
    margin-right: 0.75rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .editor.en-solucion .en-solucion-etiqueta {
    display: inline-block;
  }

  .editor .panel {
    flex: 1;
    min-height: 0;
  }

  .editor .panel[hidden] {
    display: none;
  }

  .editor .panel-resultado {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .editor .vista-contenedor {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  /* El resultado va en claro: se distingue de un vistazo del código, que es oscuro */
  .editor .vista {
    flex: 1;
    min-height: 0;
    background: #fff;
  }

  .editor .vista iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Chatbot WebMCP flotante (reto 2) ── */

  .editor .chat-fab {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    z-index: 12;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem 0.55rem 0.8rem;
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.28);
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .editor .chat-fab[hidden] {
    display: none;
  }

  .editor .chat-fab:hover {
    background: #1c1c1c;
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .editor .chat-fab svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .editor .chat-fab-cuenta {
    display: inline-grid;
    place-items: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: #262626;
    color: var(--hueco);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
  }

  .editor .chat-fab-cuenta[data-activo='true'] {
    background: #3fdc6f24;
    color: var(--ok);
  }

  .editor .chat-panel {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    width: min(370px, calc(100% - 1.5rem));
    height: min(490px, calc(100% - 1.5rem));
    border: 1px solid #d4d4d2;
    border-radius: 14px;
    background: #ffffff;
    color: #171717;
    box-shadow: 0 22px 54px rgb(0 0 0 / 0.36);
    overflow: hidden;
    font-family: var(--sans);
    color-scheme: light;
  }

  .editor .chat-panel[hidden] {
    display: none;
  }

  .editor .chat-cabecera {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.85rem;
    background: #111111;
    color: #ededed;
    border-bottom: 1px solid #262626;
  }

  .editor .chat-icono-cabecera {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: #ff3b301f;
    color: var(--accent);
    flex-shrink: 0;
  }

  .editor .chat-titulo {
    flex: 1;
    min-width: 0;
  }

  .editor .chat-nombre {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--pixel);
    font-size: 0.95rem;
    line-height: 1.2;
    color: #ffffff;
  }

  .editor .chat-badge {
    padding: 0.08rem 0.42rem;
    border-radius: 999px;
    background: #ff3b3026;
    color: #ff6b63;
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .editor .chat-estado {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.1rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .editor .chat-estado::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--hueco);
    flex-shrink: 0;
  }

  .editor .chat-estado[data-activo='true']::before {
    background: var(--ok);
  }

  .editor .chat-estado[data-ocupado='true']::before {
    background: var(--hueco);
    animation: chat-pulso 0.75s ease-in-out infinite alternate;
  }

  .editor .chat-acciones {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .editor .chat-icono-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid #2c2c2c;
    border-radius: 8px;
    background: #181818;
    color: #a1a1aa;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .editor .chat-icono-btn svg {
    display: block;
    transition: transform 0.25s ease;
  }

  .editor .chat-icono-btn:hover {
    background: #242424;
    border-color: #4a4a4a;
    color: #ffffff;
  }

  .editor .chat-icono-btn.chat-reiniciar:hover svg {
    transform: rotate(-45deg);
  }

  .editor .chat-icono-btn:active {
    background: #2a2a2a;
  }

  .editor .chat-mensajes {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 0.85rem;
    background: #f5f5f4;
    scrollbar-color: #00000033 transparent;
  }

  .editor .chat-fila {
    display: flex;
    margin-bottom: 0.55rem;
  }

  .editor .chat-fila:last-child {
    margin-bottom: 0;
  }

  .editor .chat-fila.usuario {
    justify-content: flex-end;
  }

  .editor .chat-burbuja {
    max-width: 88%;
    padding: 0.55rem 0.8rem;
    border-radius: 13px;
    font-size: 0.86rem;
    line-height: 1.48;
    word-break: break-word;
  }

  .editor .chat-burbuja p {
    margin: 0.2rem 0;
  }

  .editor .chat-burbuja p:first-child {
    margin-top: 0;
  }

  .editor .chat-burbuja p:last-child {
    margin-bottom: 0;
  }

  .editor .chat-burbuja ul,
  .editor .chat-burbuja ol {
    margin: 0.3rem 0;
    padding-left: 1.15rem;
  }

  .editor .chat-burbuja code {
    padding: 0.05rem 0.3rem;
    border: 1px solid #e4e4e2;
    border-radius: 4px;
    background: #f5f5f4;
    color: #171717;
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .editor .chat-burbuja.usuario {
    border-bottom-right-radius: 4px;
    background: #171717;
    color: #ffffff;
  }

  .editor .chat-burbuja.asistente {
    border-bottom-left-radius: 4px;
    background: #ffffff;
    color: #171717;
    border: 1px solid #e4e4e2;
  }

  .editor .chat-burbuja.escribiendo > p:last-child::after,
  .editor .chat-burbuja.escribiendo > ul:last-child > li:last-child::after,
  .editor .chat-burbuja.escribiendo > ol:last-child > li:last-child::after,
  .editor .chat-burbuja.escribiendo:empty::after {
    content: '▍';
    margin-left: 2px;
    color: var(--accent);
    animation: chat-parpadeo 0.9s steps(1) infinite;
  }

  @keyframes chat-parpadeo {
    50% {
      opacity: 0;
    }
  }

  .editor .chat-burbuja.error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
  }

  .editor .chat-burbuja.error small {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: #b91c1c;
    word-break: break-word;
  }

  .editor .chat-boton-token {
    margin-top: 0.5rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .editor .chat-boton-token:hover {
    border-color: var(--accent);
    filter: brightness(1.08);
  }

  .editor .chat-pensando {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid #e4e4e2;
    border-radius: 12px;
    background: #ffffff;
    font-size: 0.78rem;
    color: #6b6b6b;
  }

  .editor .chat-puntos {
    display: inline-flex;
    gap: 0.2rem;
  }

  .editor .chat-puntos i {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--accent);
    animation: chat-pulso 0.7s ease-in-out infinite alternate;
  }

  .editor .chat-puntos i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .editor .chat-puntos i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .editor .chat-tiempo {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: #9a9a9a;
  }

  .editor .chat-chip {
    width: 100%;
    border: 1px solid #dcdcd9;
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .editor .chat-chip-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    background: #f0f0ee;
    color: #525252;
  }

  .editor .chat-chip-cabecera strong {
    color: #171717;
  }

  .editor .chat-chip-punto {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--hueco);
    animation: chat-pulso 0.7s ease-in-out infinite alternate;
    flex-shrink: 0;
  }

  .editor .chat-chip-punto.pendiente {
    background: var(--accent);
  }

  .editor .chat-chip-punto.ok {
    background: #16a34a;
    animation: none;
  }

  .editor .chat-chip-punto.error {
    background: #dc2626;
    animation: none;
  }

  .editor .chat-chip-punto.cancelado {
    background: #737373;
    animation: none;
  }

  .editor .chat-chip-tag {
    margin-left: auto;
    padding: 0.05rem 0.38rem;
    border-radius: 4px;
    font-size: 0.64rem;
    border: 1px solid #d4d4d2;
  }

  .editor .chat-chip-tag.no-fiable {
    border-color: #f59e0b88;
    background: #fffbeb;
    color: #b45309;
  }

  .editor .chat-chip-tag.consecuencias {
    border-color: #ef444488;
    background: #fef2f2;
    color: #b91c1c;
  }

  .editor .chat-chip-args {
    margin: 0;
    padding: 0.45rem 0.65rem 0;
    border: 0;
    background: transparent !important;
    color: #166534;
    font-size: 0.68rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .editor .chat-chip-resultado {
    padding: 0.35rem 0.65rem 0.5rem;
    color: #525252;
  }

  .editor .chat-chip-resultado.error {
    color: #b91c1c;
  }

  .editor .chat-chip-resultado.cancelado {
    color: #737373;
  }

  .editor .chat-chip-confirmar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.45rem 0.65rem;
    border-top: 1px solid #fecaca;
    background: #fef2f2;
    color: #991b1b;
    font-family: var(--sans);
    font-size: 0.76rem;
  }

  .editor .chat-chip-botones {
    display: flex;
    gap: 0.35rem;
  }

  .editor .chat-chip-botones button {
    padding: 0.2rem 0.55rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: #171717;
    border-color: #d4d4d2;
    background: #ffffff;
  }

  .editor .chat-chip-botones button.peligro {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .editor .chat-pie {
    padding: 0.65rem;
    border-top: 1px solid #e4e4e2;
    background: #ffffff;
  }

  .editor .chat-sugerencias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }

  .editor .chat-sugerencias:empty {
    display: none;
  }

  .editor .chat-sugerencia {
    padding: 0.28rem 0.6rem;
    border: 1px solid #dcdcd9;
    border-radius: 999px;
    background: #f5f5f4;
    color: #262626;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 500;
    white-space: normal;
    text-align: left;
  }

  .editor .chat-sugerencia:hover {
    border-color: #171717;
    background: #ebebea;
  }

  .editor .chat-form {
    display: flex;
    align-items: end;
    gap: 0.45rem;
  }

  .editor .chat-form textarea {
    flex: 1;
    min-width: 0;
    max-height: 6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid #d4d4d2;
    border-radius: 10px;
    background: #f5f5f4;
    color: #171717;
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.4;
    resize: none;
  }

  .editor .chat-form textarea:focus {
    outline: none;
    border-color: #171717;
    background: #ffffff;
  }

  .editor .chat-enviar {
    height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid #171717;
    border-radius: 999px;
    background: #171717;
    color: #ffffff;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .editor .chat-enviar:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
  }

  .editor .chat-enviar:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  @keyframes chat-pulso {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }

  .editor .error-ejecucion {
    display: block;
    width: 100%;
    max-height: 5.5rem;
    overflow: hidden;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-top: 1px solid #ff3b3066;
    border-radius: 0;
    background: #2a0d0b;
    color: #ffb4ae;
    text-align: left;
    white-space: pre-wrap;
    font-size: 0.78rem;
  }

  .editor .error-ejecucion[hidden] {
    display: none;
  }

  /* ── Agente (reto de WebMCP) ── */

  .editor .agente {
    max-height: 48%;
    overflow: auto;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.8rem;
  }

  .editor .agente summary {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.55rem 0.9rem;
    background: var(--surface);
    cursor: pointer;
    font-family: var(--pixel);
    font-size: 0.95rem;
  }

  .editor .agente summary .muted {
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .editor .agente .agente-titulo {
    padding: 0 0.9rem 0.5rem;
    color: var(--muted);
  }

  .editor .agente .agente-herramientas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .editor .agente .agente-herramientas > li {
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--line);
  }

  .editor .agente .agente-nombre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .editor .agente .agente-nombre code {
    font-weight: 700;
  }

  .editor .agente .anotacion {
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .editor .agente .anotacion.no-fiable {
    border-color: #ffb00066;
    color: #ffb000;
  }

  .editor .agente .anotacion.consecuencias {
    border-color: #ff3b3066;
    color: var(--accent);
  }

  .editor .agente .agente-descripcion {
    margin-block: 0.25rem 0.5rem;
    color: var(--muted);
  }

  .editor .agente form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
  }

  .editor .agente label span {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .editor .agente label b {
    color: var(--accent);
  }

  .editor .agente input,
  .editor .agente select {
    width: 9.5rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 0.78rem;
  }

  .editor .agente .agente-resultado {
    margin-top: 0.5rem;
    max-height: 14rem;
    overflow: auto;
    padding: 0.6rem 0.75rem;
    font-size: 0.75rem;
    border-color: #3fdc6f44;
  }

  .editor .agente .agente-resultado.error {
    border-color: #ff3b3066;
    color: #ffb4ae;
  }

  /* ── Consola ── */

  .editor .consola {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: auto;
    font-size: 0.78rem;
    background: var(--surface);
  }

  .editor .consola li {
    padding: 0.35rem 0.9rem;
    border-bottom: 1px solid #1c1c1c;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .editor .consola li.vacia {
    color: var(--muted);
  }

  .editor .consola li.warn {
    background: #2a2109;
    color: #ffd27a;
  }

  .editor .consola li.error {
    background: #2a0d0b;
    color: #ffb4ae;
  }

  .editor .consola .enlace,
  .editor .error-ejecucion .enlace {
    padding: 0;
    border: 0;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: inherit;
  }

  /* ── Pasos ── */

  .editor .pasos {
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .editor.ampliado .pasos {
    max-height: 32vh;
    overflow: auto;
  }

  .editor .pasos-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-bottom: 0.6rem;
  }

  .editor .progreso {
    font-family: var(--pixel);
    color: var(--accent);
  }

  .editor .hecho {
    display: none;
    font-family: var(--pixel);
    color: #3fdc6f;
  }

  .editor.completado .hecho {
    display: inline;
  }

  .editor.completado .progreso {
    color: #3fdc6f;
  }

  .editor .ayuda {
    font-size: 0.75rem;
    margin-left: auto;
  }

  .editor .ayuda code {
    color: var(--hueco);
  }

  .editor .lista-pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.5rem;
  }

  .editor .lista-pasos > li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
  }

  .editor .pasos .ir {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 0.15rem 0.55rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: 0;
    text-align: left;
    white-space: normal;
  }

  .editor .pasos .estado {
    width: 0.9rem;
    height: 0.9rem;
    align-self: center;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }

  .editor .pasos .numero {
    font-family: var(--pixel);
    color: var(--muted);
  }

  .editor .pasos .titulo {
    font-size: 0.85rem;
  }

  .editor .pasos .donde {
    grid-column: 3;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.7rem;
    color: var(--muted);
  }

