---
import BackLink from '../../components/directo/BackLink.astro';
import Layout from '../../layouts/Directo.astro';
import { buildFixtures, COMPETITIONS, formatEuros, HOME_CREST, MAX_TICKETS, ZONES } from '../../lib/directo/campnou/data.ts';

// Los partidos dependen de la fecha de hoy.
export const prerender = false;

const fixtures = buildFixtures();
const next = fixtures[0]!;
const fromPrice = (prices: Record<string, number>) =>
	Math.min(...ZONES.filter((zone) => !zone.membersOnly).map((zone) => prices[zone.id]!));

const matchParamDescription =
	'Id del partido: ' +
	fixtures.map((f) => `${f.id} = FC Barcelona vs ${f.rival}, ${f.dateLong} a las ${f.time}`).join('; ');
const zoneParamDescription =
	'Zona del estadio: ' + ZONES.map((z) => `${z.id} = ${z.name} (${z.detail})`).join('; ');
---

<Layout title="Entradas · Spotify Camp Nou" description="Compra tus entradas para los partidos del FC Barcelona en el Spotify Camp Nou." icon={HOME_CREST} light requiereToken>
	<div class="cn">
		<div class="utility">
			<div class="wrap utility-row">
				<BackLink />
				<nav aria-label="Sitios del club">
					<a href="#partidos">FC Barcelona</a>
					<a href="#tour">Tour</a>
					<a href="#como-llegar">Cómo llegar</a>
					<span class="lang">CA · <strong>ES</strong> · EN</span>
				</nav>
			</div>
		</div>

		<header class="nav">
			<div class="wrap nav-row">
				<a class="brand" href="#top" aria-label="Spotify Camp Nou, inicio">
					<img class="brand-emblem" src={HOME_CREST} alt="" />
					<span class="brand-text">
						<span class="brand-kicker">Spotify</span>
						<span class="brand-name">Camp Nou</span>
					</span>
				</a>
				<nav class="nav-links" aria-label="Principal">
					<a href="#partidos">Partidos</a>
					<a href="#entradas">Entradas</a>
					<a href="#tour">Tour</a>
					<a href="#como-llegar">Cómo llegar</a>
				</nav>
				<a class="btn btn-gold nav-cta" href="#entradas">Comprar entradas</a>
			</div>
		</header>

		<section class="hero" id="top">
			<img src="/campnou/hero.webp" alt="El Camp Nou lleno en una noche de partido, con las gradas iluminadas por los móviles" fetchpriority="high" />
			<div class="hero-shade"></div>
			<div class="wrap hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">Temporada 2026/27</p>
					<h1>Vive el Camp Nou</h1>
					<p class="lede">
						Entradas para LaLiga y la UEFA Champions League en el nuevo Spotify Camp Nou, el estadio más grande de Europa.
					</p>
					<div class="hero-actions">
						<a class="btn btn-gold" href="#entradas">Comprar entradas</a>
						<a class="btn btn-ghost" href="#partidos">Ver calendario</a>
					</div>
				</div>
				<aside class="next" aria-label="Próximo partido">
					<p class="next-label">Próximo partido · {COMPETITIONS[next.competition]}</p>
					<div class="next-teams">
						<img class="crest" src={HOME_CREST} alt="FC Barcelona" />
						<span class="vs">vs</span>
						<img class="crest" src={next.crest} alt={next.rival} />
					</div>
					<p class="next-title">FC Barcelona – {next.rival}</p>
					<p class="next-date">{next.dateLong} · {next.time} h</p>
					<button class="btn btn-navy buy" type="button" data-buy={next.id}>Entradas desde {formatEuros(fromPrice(next.prices))}</button>
				</aside>
			</div>
		</section>

		<section class="section" id="partidos">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow dark">Calendario</p>
					<h2>Próximos partidos en casa</h2>
				</div>
				<ol class="fixtures">
					{
						fixtures.map((f) => {
							const [weekday, day, month] = f.dateLabel.split(' ');
							return (
								<li class="fixture" data-competition={f.competition}>
									<div class="fixture-date">
										<span class="fixture-day">{day}</span>
										<span class="fixture-month">{month}</span>
										<span class="fixture-weekday">
											{weekday} · {f.time}
										</span>
									</div>
									<div class="fixture-body">
										<p class="fixture-comp">
											{COMPETITIONS[f.competition]}
											{f.tag && <span class="tag">{f.tag}</span>}
										</p>
										<p class="fixture-teams">
											<img class="crest small" src={HOME_CREST} alt="" loading="lazy" />
											FC Barcelona <span class="dash">–</span> {f.rival}
											<img class="crest small" src={f.crest} alt="" loading="lazy" />
										</p>
									</div>
									<div class="fixture-buy">
										<p class:list={['stock', { low: f.status === 'ultimas' }]}>
											{f.status === 'ultimas' ? 'Últimas entradas' : 'Disponible'}
										</p>
										<p class="from">desde <strong>{formatEuros(fromPrice(f.prices))}</strong></p>
										<button class="btn btn-navy buy" type="button" data-buy={f.id}>Comprar</button>
									</div>
								</li>
							);
						})
					}
				</ol>
			</div>
		</section>

		<section class="section tickets" id="entradas">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow dark">Venta oficial</p>
					<h2>Reserva tus entradas</h2>
					<p class="section-lede">Elige partido y zona en el plano, o pídeselo al asistente virtual.</p>
					<p id="support-badge" class="support">Comprobando soporte…</p>
				</div>

				<div class="tickets-grid">
					<div class="map-card">
						<svg class="map" viewBox="0 0 400 260" role="group" aria-label="Plano del estadio">
							<rect x="6" y="6" width="388" height="248" rx="96" class="map-shell" />
							<path class="zone" data-zone="lateral" tabindex="0" role="button" aria-label="Lateral" d="M104 72H296L324 20H76Z" />
							<path class="zone" data-zone="tribuna" tabindex="0" role="button" aria-label="Tribuna" d="M104 188H296L324 240H76Z" />
							<path class="zone" data-zone="gol-nord" tabindex="0" role="button" aria-label="Gol Nord" d="M98 80V180L58 228Q14 130 58 32Z" />
							<path class="zone" data-zone="gol-sud" tabindex="0" role="button" aria-label="Gol Sud, Grada d'Animació" d="M302 80V180L342 228Q386 130 342 32Z" />
							<rect class="zone" data-zone="palco-vip" tabindex="0" role="button" aria-label="Palco VIP" x="164" y="193" width="72" height="15" rx="3" />
							<g class="pitch" aria-hidden="true">
								<rect x="110" y="80" width="180" height="100" rx="2" class="grass" />
								<g class="lines">
									<rect x="116" y="86" width="168" height="88" />
									<line x1="200" y1="86" x2="200" y2="174" />
									<circle cx="200" cy="130" r="13" />
									<rect x="116" y="108" width="24" height="44" />
									<rect x="260" y="108" width="24" height="44" />
								</g>
							</g>
							<g class="labels" aria-hidden="true">
								<text x="200" y="50">Lateral</text>
								<text x="200" y="228">Tribuna</text>
								<text x="200" y="203.5" class="vip">Palco VIP</text>
								<text x="62" y="130" transform="rotate(-90 62 130)">Gol Nord</text>
								<text x="338" y="130" transform="rotate(90 338 130)">Gol Sud · Socios</text>
							</g>
						</svg>
						<ul class="legend" id="legend">
							{
								ZONES.map((z) => (
									<li>
										<button type="button" data-zone={z.id}>
											<span class="legend-name">{z.name}</span>
											<span class="legend-detail">{z.detail}</span>
											<span class="legend-price" data-price={z.id}>{formatEuros(next.prices[z.id]!)}</span>
										</button>
									</li>
								))
							}
						</ul>
					</div>

					<div id="form-card" class="form-card">
						<form
							id="reservationForm"
							toolname="reservar_entradas_camp_nou"
							tooldescription="Reserva entradas para un partido del FC Barcelona en el Spotify Camp Nou, Barcelona"
							novalidate
						>
							<fieldset>
								<legend>1. Partido y zona</legend>
								<div class="field">
									<label for="partido">Partido</label>
									<select id="partido" name="partido" required class="field-input" toolparamdescription={matchParamDescription}>
										{fixtures.map((f) => <option value={f.id}>FC Barcelona – {f.rival} · {f.dateLabel} · {f.time}</option>)}
									</select>
									<p class="error-msg hidden">Elige uno de los partidos a la venta.</p>
								</div>
								<div class="grid">
									<div class="field">
										<label for="zona">Zona</label>
										<select id="zona" name="zona" required class="field-input" toolparamdescription={zoneParamDescription}>
											{ZONES.map((z) => <option value={z.id}>{z.name}</option>)}
										</select>
										<p class="error-msg hidden">Elige una zona del estadio.</p>
									</div>
									<div class="field">
										<label for="num-entradas">Entradas</label>
										<select
											id="num-entradas"
											name="entradas"
											required
											class="field-input"
											toolparamdescription={`Número de entradas, de 1 a ${MAX_TICKETS} (en El Clásico, máximo 2 por persona)`}
										>
											{Array.from({ length: MAX_TICKETS }, (_, i) => <option value={String(i + 1)} selected={i === 1}>{i + 1}</option>)}
										</select>
										<p class="error-msg hidden">Elige cuántas entradas quieres.</p>
									</div>
								</div>
							</fieldset>

							<fieldset>
								<legend>2. Titular</legend>
								<div class="field">
									<label for="nombre">Nombre y apellidos</label>
									<input id="nombre" name="nombre" type="text" required autocomplete="name" class="field-input" placeholder="Laia Puig Ferrer" toolparamdescription="Nombre y apellidos del titular de las entradas" />
									<p class="error-msg hidden">Escribe nombre y apellidos.</p>
								</div>
								<div class="grid">
									<div class="field">
										<label for="email">Email</label>
										<input id="email" name="email" type="email" required autocomplete="email" class="field-input" placeholder="laia@correo.es" toolparamdescription="Email donde se envían las entradas" />
										<p class="error-msg hidden">Escribe un email válido.</p>
									</div>
									<div class="field">
										<label for="telefono">Móvil</label>
										<input id="telefono" name="telefono" type="tel" required autocomplete="tel" class="field-input" placeholder="612 345 678" toolparamdescription="Móvil español de 9 dígitos, con o sin +34" />
										<p class="error-msg hidden">Escribe un móvil español de 9 dígitos.</p>
									</div>
								</div>
								<div class="field">
									<label for="socio">Nº de socio <span id="socio-hint">opcional</span></label>
									<input id="socio" name="socio" type="text" inputmode="numeric" class="field-input" placeholder="Solo para socios del FC Barcelona" toolparamdescription="Número de socio del FC Barcelona (5 a 8 dígitos). Obligatorio para el Gol Sud (Grada d'Animació)" />
									<p class="error-msg hidden">El número de socio tiene entre 5 y 8 dígitos.</p>
								</div>
								<div class="field">
									<label for="notas">Peticiones <span>opcional</span></label>
									<textarea id="notas" name="notas" rows="2" class="field-input" placeholder="Movilidad reducida, asientos juntos…" toolparamdescription="Peticiones especiales: accesibilidad, asientos juntos (opcional)"></textarea>
								</div>
							</fieldset>

							<div class="summary" aria-live="polite">
								<div>
									<p class="summary-match" id="summary-match"></p>
									<p class="summary-line" id="summary-line"></p>
								</div>
								<p class="summary-total"><span>Total</span><strong id="summary-total"></strong></p>
							</div>

							<button type="submit" id="submit-btn" class="btn btn-gold submit">Reservar entradas</button>
							<p class="fine">Máximo {MAX_TICKETS} entradas por compra. Las entradas son nominativas y llegan a tu email.</p>
						</form>
					</div>
				</div>
			</div>
		</section>

		<section class="section feature" id="tour">
			<div class="wrap feature-grid">
				<img src="/campnou/interior.webp" alt="Gradas del Camp Nou con el lema «Més que un club»" loading="lazy" />
				<div>
					<p class="eyebrow dark">Tour y Museo</p>
					<h2>Més que un club</h2>
					<p>
						Recorre el vestuario, el túnel de jugadores, la sala de prensa y el Museo, con las cinco Copas de Europa del
						club.
					</p>
					<ul class="facts">
						<li><strong>1957</strong> inaugurado</li>
						<li><strong>105.000</strong> localidades</li>
						<li><strong>Nº 1</strong> en aforo de Europa</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="section access" id="como-llegar">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow dark">Cómo llegar</p>
					<h2>C. d'Arístides Maillol, 12 · Barcelona</h2>
				</div>
				<div class="access-grid">
					<article>
						<p class="access-kind">Metro</p>
						<p class="access-main">Les Corts · Palau Reial</p>
						<p>Línea 3 (verde)</p>
					</article>
					<article>
						<p class="access-kind">Metro</p>
						<p class="access-main">Collblanc · Badal</p>
						<p>Línea 5 (azul)</p>
					</article>
					<article>
						<p class="access-kind">Tranvía</p>
						<p class="access-main">Palau Reial</p>
						<p>T1 · T2 · T3, a 10 minutos andando</p>
					</article>
					<article>
						<p class="access-kind">Puertas</p>
						<p class="access-main">90 min antes</p>
						<p>Accesos por Arístides Maillol y Travessera de les Corts</p>
					</article>
				</div>
				<img class="exterior" src="/campnou/exterior.webp" alt="Vista aérea del Camp Nou y sus gradas azulgranas" loading="lazy" />
			</div>
		</section>

		<footer class="foot">
			<div class="wrap foot-grid">
				<div class="foot-brand">
					<img class="foot-emblem" src={HOME_CREST} alt="" loading="lazy" />
					<p>Spotify Camp Nou<br />C. d'Arístides Maillol, 12<br />08028 Barcelona</p>
				</div>
				<nav aria-label="Estadio">
					<p>Estadio</p>
					<a href="#entradas">Entradas</a>
					<a href="#tour">Tour</a>
					<a href="#como-llegar">Cómo llegar</a>
				</nav>
				<nav aria-label="Ayuda">
					<p>Ayuda</p>
					<a href="#entradas">Preguntas frecuentes</a>
					<a href="#entradas">Accesibilidad</a>
					<a href="#entradas">Contacto</a>
				</nav>
			</div>
			<div class="wrap foot-legal">
				<p>
					Web de demostración para una charla sobre WebMCP. No es la web oficial del FC Barcelona y no vende entradas
					reales.
				</p>
				<p>
					Fotos vía Wikimedia Commons: JaflaumS05 (CC BY-SA 4.0), Luis Miguel Bugallo Sánchez (CC BY-SA 3.0),
					Oh-Barcelona.com (CC BY 2.0). Escudos: marcas de sus clubes, vía Wikipedia.
				</p>
			</div>
		</footer>
	</div>

	<button id="chat-fab" type="button" aria-label="Abrir el asistente virtual">
		<svg id="fab-icon-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3 0-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z" /></svg>
		<svg id="fab-icon-close" class="hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
		<span>Asistente</span>
	</button>

	<div id="chat-panel" class="panel hidden" role="dialog" aria-label="Asistente virtual del Spotify Camp Nou">
		<div class="panel-head">
			<img class="panel-emblem" src={HOME_CREST} alt="" />
			<div class="panel-title">
				<p>Asistente virtual</p>
				<p id="agent-status">En línea</p>
			</div>
			<span class="panel-badge" id="panel-badge">WebMCP</span>
			<button id="reset-chat" type="button">Reiniciar</button>
		</div>
		<div id="live-stage" hidden data-state="connecting">
			<div class="live-orb" aria-hidden="true">
				<span class="live-wave w1"></span>
				<span class="live-wave w2"></span>
				<span class="live-wave w3"></span>
				<span class="live-user"></span>
				<span class="live-core"><img src={HOME_CREST} alt="" /></span>
			</div>
			<p id="live-title" aria-live="polite">Conectando…</p>
			<p id="live-sub">GPT-Live · gpt-6-luna rellena el formulario con WebMCP</p>
		</div>
		<div id="chat-log"></div>
		<div class="panel-foot">
			<div id="suggestions"></div>
			<form id="chat-form">
				<textarea id="chat-input" rows="1" aria-label="Mensaje para el asistente" placeholder="Escribe tu mensaje…"></textarea>
				<button id="voice-btn" type="button" aria-label="Hablar con el asistente" title="Modo voz">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg>
				</button>
				<button id="live-btn" type="button" aria-label="Conversación en vivo con GPT-Live" title="En vivo (GPT-Live)">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4" /></svg>
				</button>
				<button id="send-btn" type="submit">Enviar</button>
			</form>
			<div id="live-controls" hidden>
				<button id="live-mute" type="button" aria-pressed="false">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg>
					<span>Silenciar</span>
				</button>
				<button id="live-end" type="button">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 14.5c4.7-4.2 12.3-4.2 17 0l-2.3 2.3-3.3-1.6v-2.4a11 11 0 0 0-5.8 0v2.4l-3.3 1.6z" /></svg>
					<span>Colgar</span>
				</button>
			</div>
			<div id="voice-bar" hidden data-state="off">
				<button id="voice-orb" type="button" aria-label="Modo voz">
					<span class="orb-ring" aria-hidden="true"></span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg>
				</button>
				<div class="voice-copy" aria-live="polite">
					<p id="voice-title">Cargando Whisper…</p>
					<p id="voice-sub">Whisper base · WebGPU · en tu navegador</p>
					<div id="voice-progress" hidden><i></i></div>
				</div>
				<button id="voice-exit" type="button" title="Volver al teclado">Teclado</button>
			</div>
		</div>
	</div>

	<dialog id="booking-dialog">
		<div class="ticket">
			<div class="ticket-head">
				<img class="ticket-emblem" src={HOME_CREST} alt="" />
				<div>
					<p class="ticket-kicker">Reserva confirmada</p>
					<p class="ticket-code" id="ticket-code"></p>
				</div>
			</div>
			<div class="ticket-body">
				<div class="ticket-crests" aria-hidden="true">
					<img src={HOME_CREST} alt="" />
					<span>vs</span>
					<img id="ticket-rival-crest" src={next.crest} alt="" />
				</div>
				<p class="ticket-comp" id="ticket-comp"></p>
				<p class="ticket-match" id="ticket-match"></p>
				<p class="ticket-date" id="ticket-date"></p>
				<dl class="ticket-seats">
					<div><dt>Zona</dt><dd id="ticket-zone"></dd></div>
					<div><dt>Puerta</dt><dd id="ticket-gate"></dd></div>
					<div><dt>Sector</dt><dd id="ticket-sector"></dd></div>
					<div><dt>Fila</dt><dd id="ticket-row"></dd></div>
					<div><dt>Asientos</dt><dd id="ticket-seat"></dd></div>
					<div><dt>Total</dt><dd id="ticket-total"></dd></div>
				</dl>
			</div>
			<div class="ticket-foot">
				<div class="qr" id="ticket-qr"></div>
				<p id="modal-details"></p>
			</div>
			<button id="close-dialog-btn" type="button" class="btn btn-navy">Listo</button>
		</div>
	</dialog>

	<script type="application/json" id="fixtures-data" set:html={JSON.stringify(fixtures)} />
</Layout>

<style>
	@font-face {
		font-family: 'Barlow';
		src: url('../../assets/fonts/Barlow-400-latin.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('../../assets/fonts/Barlow-500-latin.woff2') format('woff2');
		font-weight: 500;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('../../assets/fonts/Barlow-600-latin.woff2') format('woff2');
		font-weight: 600;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('../../assets/fonts/Barlow-700-latin.woff2') format('woff2');
		font-weight: 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow Condensed';
		src: url('../../assets/fonts/BarlowCondensed-600-latin.woff2') format('woff2');
		font-weight: 600;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow Condensed';
		src: url('../../assets/fonts/BarlowCondensed-700-latin.woff2') format('woff2');
		font-weight: 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow Condensed';
		src: url('../../assets/fonts/BarlowCondensed-800-latin.woff2') format('woff2');
		font-weight: 800;
		font-display: swap;
	}

	:global(html[data-theme='light']) {
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
	}

	:global(body:has(.cn)) {
		--navy: #0c1b4d;
		--navy-2: #16296b;
		--royal: #004d98;
		--grana: #a50044;
		--gold: #edbb00;
		--gold-2: #d4a700;
		--mist: #f3f5f9;
		--line: #e1e6ee;
		--ink: #0c1b4d;
		--soft: #5b6477;
		--sans: 'Barlow', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
		font-family: var(--sans);
	}

	.cn {
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.5;
	}

	.wrap {
		width: min(100% - 2.5rem, 76rem);
		margin-inline: auto;
	}

	.hidden {
		display: none !important;
	}

	/* ---------- Cabecera ---------- */
	.utility {
		background: var(--navy);
		border-bottom: 4px solid;
		border-image: repeating-linear-gradient(90deg, var(--royal) 0 3rem, var(--grana) 3rem 6rem) 1;
		color: #c9d3e6;
		font-size: 0.75rem;
	}
	.utility-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 2.25rem;
	}
	.utility nav {
		display: flex;
		gap: 1.5rem;
	}
	.utility a {
		color: inherit;
		text-decoration: none;
	}
	.utility a:hover {
		color: #fff;
	}
	.lang strong {
		color: #fff;
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(255 255 255 / 96%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.nav-row {
		display: flex;
		align-items: center;
		gap: 2rem;
		min-height: 4.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--navy);
		text-decoration: none;
	}
	.brand-emblem {
		width: auto;
		height: 3rem;
	}
	.brand-text {
		display: grid;
		line-height: 1;
		text-transform: uppercase;
		font-family: var(--display);
	}
	.brand-kicker {
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.22em;
		color: var(--soft);
	}
	.brand-name {
		font-weight: 800;
		font-size: 1.45rem;
		letter-spacing: 0.02em;
	}
	.nav-links {
		display: flex;
		gap: 1.75rem;
		margin-left: auto;
	}
	.nav-links a {
		position: relative;
		color: var(--navy);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
	}
	.nav-links a::after {
		content: '';
		position: absolute;
		inset: auto 0 -0.5rem;
		height: 3px;
		background: var(--grana);
		transform: scaleX(0);
		transition: transform 0.2s;
	}
	.nav-links a:hover::after {
		transform: scaleX(1);
	}

	/* ---------- Botones ---------- */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.4rem;
		border: 0;
		border-radius: 999px;
		font-family: var(--sans);
		font-weight: 700;
		font-size: 0.9rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		cursor: pointer;
		transition:
			background 0.15s,
			color 0.15s,
			transform 0.15s;
	}
	.btn:active {
		transform: translateY(1px);
	}
	.btn:focus-visible {
		outline: 3px solid var(--royal);
		outline-offset: 2px;
	}
	.btn-gold {
		background: var(--gold);
		color: var(--navy);
	}
	.btn-gold:hover {
		background: var(--gold-2);
	}
	.btn-navy {
		background: var(--navy);
		color: #fff;
	}
	.btn-navy:hover {
		background: var(--royal);
	}
	.btn-ghost {
		background: rgb(255 255 255 / 12%);
		color: #fff;
		box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 70%);
	}
	.btn-ghost:hover {
		background: rgb(255 255 255 / 22%);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: grid;
		align-items: end;
		min-height: min(78vh, 46rem);
		color: #fff;
		background: var(--navy);
		overflow: hidden;
	}
	.hero > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 62%;
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgb(10 20 60 / 88%) 0%, rgb(10 20 60 / 55%) 48%, rgb(165 0 68 / 18%) 100%),
			linear-gradient(0deg, rgb(10 20 60 / 70%) 0%, transparent 45%);
	}
	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 22rem;
		align-items: end;
		gap: 2rem;
		padding-block: 5rem 3.5rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		font-family: var(--display);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--gold);
	}
	.eyebrow.dark {
		color: var(--royal);
	}
	h1,
	h2 {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		text-transform: uppercase;
		line-height: 0.92;
		letter-spacing: 0.005em;
	}
	h1 {
		font-size: clamp(3.4rem, 8vw, 6.5rem);
	}
	.lede {
		max-width: 34rem;
		margin: 1.25rem 0 0;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		color: #e4e9f3;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.next {
		padding: 1.4rem;
		border-radius: 14px;
		background: #fff;
		color: var(--ink);
		box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
	}
	.next-label {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--soft);
	}
	.next-teams {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin: 1.1rem 0 0.8rem;
	}
	.vs {
		font-family: var(--display);
		font-weight: 700;
		color: var(--soft);
		text-transform: uppercase;
	}
	.next-title {
		margin: 0;
		text-align: center;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.6rem;
		text-transform: uppercase;
		line-height: 1;
	}
	.next-date {
		margin: 0.4rem 0 1.1rem;
		text-align: center;
		color: var(--soft);
		font-weight: 500;
	}
	.next-date::first-letter {
		text-transform: uppercase;
	}
	.next .btn {
		width: 100%;
	}

	.crest {
		width: 4rem;
		height: 4rem;
		object-fit: contain;
	}
	.crest.small {
		width: 2.2rem;
		height: 2.2rem;
	}

	/* ---------- Secciones ---------- */
	.section {
		padding-block: clamp(3.5rem, 7vw, 6rem);
	}
	.section-head {
		margin-bottom: 2.25rem;
	}
	.section-head h2,
	.feature h2 {
		font-size: clamp(2.3rem, 4.5vw, 3.4rem);
		color: var(--navy);
	}
	.section-lede {
		margin: 0.8rem 0 0;
		color: var(--soft);
		font-size: 1.1rem;
	}
	.support {
		display: inline-block;
		margin: 0.8rem 0 0;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: #e8f0fb;
		color: var(--royal);
		font-size: 0.75rem;
		font-weight: 700;
	}
	.support[hidden] {
		display: none;
	}

	.fixtures {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.fixture {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		transition:
			border-color 0.15s,
			box-shadow 0.15s;
	}
	.fixture:hover {
		border-color: #c8d2e3;
		box-shadow: 0 10px 30px rgb(12 27 77 / 8%);
	}
	.fixture-date {
		display: grid;
		justify-items: center;
		padding-right: 1.25rem;
		border-right: 1px solid var(--line);
		line-height: 1;
		font-family: var(--display);
		text-transform: uppercase;
	}
	.fixture-day {
		font-weight: 800;
		font-size: 2.4rem;
		color: var(--navy);
	}
	.fixture-month {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.1em;
		color: var(--royal);
	}
	.fixture-weekday {
		margin-top: 0.35rem;
		font-weight: 600;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
		color: var(--soft);
	}
	.fixture-comp {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.45rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--soft);
	}
	.fixture[data-competition='ucl'] .fixture-comp {
		color: #1b3fa0;
	}
	.tag {
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--grana);
		color: #fff;
		letter-spacing: 0.06em;
	}
	.fixture-teams {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.35rem, 2.4vw, 1.8rem);
		text-transform: uppercase;
		line-height: 1;
		color: var(--navy);
	}
	.dash {
		color: var(--soft);
	}
	.fixture-buy {
		display: grid;
		justify-items: end;
		gap: 0.25rem;
		text-align: right;
	}
	.fixture-buy p {
		margin: 0;
	}
	.stock {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #0f7a3d;
	}
	.stock.low {
		color: #c2410c;
	}
	.from {
		font-size: 0.85rem;
		color: var(--soft);
	}
	.from strong {
		font-size: 1.1rem;
		color: var(--navy);
	}
	.fixture-buy .btn {
		margin-top: 0.35rem;
		min-height: 2.4rem;
	}

	/* ---------- Entradas ---------- */
	.tickets {
		background: var(--mist);
	}
	.tickets-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	.map-card,
	.form-card {
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 1px 0 var(--line), 0 18px 40px rgb(12 27 77 / 6%);
	}
	.map-card {
		position: sticky;
		top: 6rem;
		padding: 1.5rem;
	}
	.map {
		display: block;
		width: 100%;
		height: auto;
	}
	.map-shell {
		fill: #e6ebf3;
	}
	.zone {
		fill: #c3cee0;
		stroke: #fff;
		stroke-width: 2;
		cursor: pointer;
		transition: fill 0.15s;
		outline: none;
	}
	.zone:hover,
	.zone:focus-visible {
		fill: #93a9cc;
	}
	.zone[data-selected='true'] {
		fill: var(--gold);
	}
	.zone[data-zone='palco-vip'] {
		fill: var(--navy-2);
	}
	.zone[data-zone='palco-vip']:hover {
		fill: var(--royal);
	}
	.zone[data-zone='palco-vip'][data-selected='true'] {
		fill: var(--gold);
	}
	.grass {
		fill: #2d8a4a;
	}
	.lines * {
		fill: none;
		stroke: rgb(255 255 255 / 75%);
		stroke-width: 1.2;
	}
	.labels text {
		font-family: var(--display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-anchor: middle;
		dominant-baseline: middle;
		fill: var(--navy);
		pointer-events: none;
	}
	.labels .vip {
		font-size: 8px;
		fill: #fff;
	}
	.map:has([data-zone='palco-vip'][data-selected='true']) .labels .vip {
		fill: var(--navy);
	}

	.legend {
		display: grid;
		gap: 0.35rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.legend button {
		display: grid;
		grid-template-columns: 1fr auto;
		width: 100%;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: #fff;
		color: var(--ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	.legend button:hover {
		border-color: #b8c5da;
	}
	.legend button[aria-pressed='true'] {
		border-color: var(--gold);
		background: #fff8e1;
		box-shadow: inset 4px 0 0 var(--gold);
	}
	.legend-name {
		font-weight: 700;
	}
	.legend-detail {
		grid-column: 1;
		font-size: 0.8rem;
		color: var(--soft);
	}
	.legend-price {
		grid-row: 1 / span 2;
		grid-column: 2;
		align-self: center;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.35rem;
		color: var(--navy);
	}

	.form-card {
		padding: 1.75rem;
		transition: box-shadow 0.2s;
	}
	:global(#form-card.tool-active) {
		box-shadow:
			0 0 0 3px var(--gold),
			0 18px 40px rgb(12 27 77 / 12%);
	}
	fieldset {
		margin: 0 0 1.25rem;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 0.4rem;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.25rem;
		text-transform: uppercase;
		color: var(--navy);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 1rem;
	}
	.field {
		display: grid;
		gap: 0.3rem;
		margin-top: 0.75rem;
	}
	label {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--navy);
	}
	label span {
		margin-left: 0.25rem;
		font-weight: 500;
		color: var(--soft);
	}
	:global(#socio-hint.required) {
		color: #c2410c;
		font-weight: 700;
	}
	.field-input {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.55rem 0.8rem;
		border: 1.5px solid #cfd7e4;
		border-radius: 10px;
		background: #fff;
		color: var(--ink);
		font: inherit;
		transition:
			border-color 0.15s,
			background 0.3s;
	}
	textarea.field-input {
		resize: vertical;
	}
	.field-input:focus {
		outline: none;
		border-color: var(--royal);
		box-shadow: 0 0 0 3px rgb(0 77 152 / 15%);
	}
	:global(.field-input.tool-filling) {
		background: #fff4cc;
		border-color: var(--gold);
	}
	:global(.field-input.invalid) {
		border-color: #dc2626;
	}
	.error-msg {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 600;
		color: #dc2626;
	}

	.summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.1rem;
		border-radius: 12px;
		background: var(--navy);
		color: #fff;
	}
	.summary p {
		margin: 0;
	}
	.summary-match {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.15rem;
		text-transform: uppercase;
		line-height: 1.1;
	}
	.summary-line {
		font-size: 0.82rem;
		color: #c9d3e6;
	}
	.summary-total {
		display: grid;
		justify-items: end;
		line-height: 1;
	}
	.summary-total span {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #c9d3e6;
	}
	.summary-total strong {
		margin-top: 0.25rem;
		font-family: var(--display);
		font-weight: 800;
		font-size: 2rem;
		color: var(--gold);
	}
	.submit {
		width: 100%;
		min-height: 3.2rem;
		margin-top: 1rem;
		font-size: 1rem;
	}
	:global(#submit-btn.tool-submit-active) {
		box-shadow: 0 0 0 4px rgb(237 187 0 / 45%);
	}
	.fine {
		margin: 0.75rem 0 0;
		font-size: 0.78rem;
		color: var(--soft);
		text-align: center;
	}

	/* ---------- Tour y acceso ---------- */
	.feature-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
	}
	.feature img,
	.exterior {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
		object-fit: cover;
	}
	.feature img {
		aspect-ratio: 4 / 3;
	}
	.feature p {
		color: var(--soft);
		font-size: 1.1rem;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--soft);
	}
	.facts strong {
		display: block;
		font-family: var(--display);
		font-weight: 800;
		font-size: 2rem;
		line-height: 1;
		text-transform: uppercase;
		color: var(--navy);
	}

	.access {
		background: var(--mist);
	}
	.access-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}
	.access article {
		padding: 1.25rem;
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 1px 0 var(--line);
	}
	.access p {
		margin: 0;
		color: var(--soft);
	}
	.access-kind {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.access .access-main {
		margin: 0.35rem 0 0.15rem;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.45rem;
		text-transform: uppercase;
		color: var(--navy);
	}
	.exterior {
		aspect-ratio: 21 / 8;
	}

	/* ---------- Footer ---------- */
	.foot {
		padding-block: 3.5rem 2rem;
		background: var(--navy);
		color: #c9d3e6;
		font-size: 0.9rem;
	}
	.foot-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
	}
	.foot-brand {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.foot-emblem {
		width: auto;
		height: 3.6rem;
		flex: none;
	}
	.foot p {
		margin: 0;
	}
	.foot nav {
		display: grid;
		align-content: start;
		gap: 0.5rem;
	}
	.foot nav p {
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-size: 0.75rem;
		color: #fff;
	}
	.foot a {
		color: inherit;
		text-decoration: none;
	}
	.foot a:hover {
		color: var(--gold);
	}
	.foot-legal {
		display: grid;
		gap: 0.25rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 12%);
		font-size: 0.75rem;
		color: #8e9ab3;
	}

	/* ---------- Asistente ---------- */
	#chat-fab {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 30;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 3.5rem;
		padding: 0 1.3rem 0 1.1rem;
		border: 0;
		border-radius: 999px;
		background: var(--navy);
		color: #fff;
		box-shadow: 0 14px 34px rgb(12 27 77 / 35%);
		font-family: var(--sans);
		font-weight: 700;
		font-size: 0.95rem;
		cursor: pointer;
		transition: background 0.15s;
	}
	#chat-fab:hover {
		background: var(--royal);
	}
	#chat-fab svg {
		width: 1.3rem;
		height: 1.3rem;
		fill: var(--gold);
		stroke: var(--gold);
		stroke-width: 2;
		stroke-linecap: round;
	}
	#fab-icon-open {
		stroke: none;
	}

	.panel {
		position: fixed;
		z-index: 30;
		right: 1.25rem;
		bottom: 5.5rem;
		display: flex;
		flex-direction: column;
		width: min(25rem, calc(100vw - 2rem));
		height: min(38rem, calc(100dvh - 7.5rem));
		border-radius: 18px;
		background: #fff;
		color: var(--ink);
		box-shadow: 0 28px 70px rgb(12 27 77 / 30%);
		overflow: hidden;
		font-family: var(--sans);
	}
	.panel-head {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.85rem 1rem;
		background: var(--navy);
		color: #fff;
	}
	.panel-emblem {
		width: auto;
		height: 2.2rem;
	}
	.panel-title {
		flex: 1;
		min-width: 0;
	}
	.panel-title p {
		margin: 0;
		line-height: 1.2;
	}
	.panel-title p:first-child {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.15rem;
		text-transform: uppercase;
	}
	#agent-status {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		color: #c9d3e6;
	}
	#agent-status::before {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #22c55e;
	}
	:global(#agent-status[data-busy='true'])::before {
		background: var(--gold);
		animation: cn-pulse 0.8s ease-in-out infinite alternate;
	}
	.panel-badge {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		background: rgb(237 187 0 / 18%);
		color: var(--gold);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	#reset-chat {
		border: 0;
		background: none;
		color: #c9d3e6;
		font: inherit;
		font-size: 0.75rem;
		cursor: pointer;
	}
	#reset-chat:hover {
		color: #fff;
	}
	#chat-log {
		flex: 1;
		overflow: auto;
		padding: 1rem;
		background: var(--mist);
	}
	:global(.cn-row) {
		display: flex;
		margin: 0.45rem 0;
	}
	:global(.cn-row.end) {
		justify-content: flex-end;
	}
	:global(.cn-bubble) {
		max-width: 86%;
		padding: 0.6rem 0.85rem;
		border-radius: 16px;
		font-size: 0.93rem;
		line-height: 1.45;
	}
	:global(.cn-bubble p) {
		margin: 0.2rem 0;
	}
	:global(.cn-bubble ul),
	:global(.cn-bubble ol) {
		margin: 0.3rem 0;
		padding-left: 1.2rem;
	}
	:global(.cn-bubble.user) {
		border-bottom-right-radius: 4px;
		background: var(--royal);
		color: #fff;
	}
	:global(.cn-bubble.agent) {
		border-bottom-left-radius: 4px;
		background: #fff;
		color: var(--ink);
		box-shadow: 0 1px 0 var(--line);
	}
	:global(.cn-bubble.error) {
		background: #fef2f2;
		color: #991b1b;
	}
	:global(.cn-bubble.error small) {
		display: block;
		margin-top: 0.25rem;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		word-break: break-all;
	}
	:global(.cn-thinking) {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.8rem;
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 1px 0 var(--line);
		font-size: 0.8rem;
		color: var(--soft);
	}
	:global(.cn-dots) {
		display: flex;
		gap: 0.2rem;
	}
	:global(.cn-dots i) {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--royal);
		animation: cn-pulse 0.7s ease-in-out infinite alternate;
	}
	:global(.cn-dots i:nth-child(2)) {
		animation-delay: 0.15s;
	}
	:global(.cn-dots i:nth-child(3)) {
		animation-delay: 0.3s;
	}
	:global(.cn-elapsed) {
		font-variant-numeric: tabular-nums;
		color: #94a3b8;
	}
	:global(.cn-chip) {
		width: 100%;
		border: 1px solid #cfd9ea;
		border-radius: 12px;
		background: #fff;
		overflow: hidden;
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.7rem;
	}
	:global(.cn-chip-head) {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.7rem;
		background: #eef3fb;
		color: var(--royal);
	}
	:global(.cn-chip-head strong) {
		color: var(--navy);
	}
	:global(.cn-chip-dot) {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--gold);
		animation: cn-pulse 0.7s ease-in-out infinite alternate;
	}
	:global(.cn-chip-dot.done) {
		background: #22c55e;
		animation: none;
	}
	:global(.cn-chip-dot.fail) {
		background: #dc2626;
		animation: none;
	}
	:global(.cn-chip pre) {
		margin: 0;
		padding: 0.5rem 0.7rem 0;
		white-space: pre-wrap;
		word-break: break-all;
		color: #0f5132;
	}
	:global(.cn-chip-result) {
		padding: 0.4rem 0.7rem 0.55rem;
		color: var(--soft);
	}
	:global(.cn-chip-result.fail) {
		color: #b91c1c;
	}
	.panel-foot {
		padding: 0.75rem;
		border-top: 1px solid var(--line);
		background: #fff;
	}
	#suggestions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.6rem;
	}
	#suggestions:empty {
		display: none;
	}
	:global(.cn-suggest) {
		padding: 0.35rem 0.7rem;
		border: 1px solid #cfd9ea;
		border-radius: 999px;
		background: #fff;
		color: var(--royal);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 600;
		text-align: left;
		cursor: pointer;
	}
	:global(.cn-suggest:hover) {
		border-color: var(--royal);
		background: #eef3fb;
	}
	#chat-form[hidden] {
		display: none;
	}
	#chat-form {
		display: flex;
		gap: 0.45rem;
		align-items: end;
	}
	#chat-input {
		flex: 1;
		max-height: 7rem;
		padding: 0.6rem 0.8rem;
		border: 1.5px solid #cfd7e4;
		border-radius: 12px;
		background: #fff;
		color: var(--ink);
		font: inherit;
		font-size: 0.93rem;
		resize: none;
	}
	#chat-input:focus {
		outline: none;
		border-color: var(--royal);
	}
	#send-btn {
		height: 2.6rem;
		padding: 0 1rem;
		border: 0;
		border-radius: 999px;
		background: var(--gold);
		color: var(--navy);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	#send-btn:disabled {
		opacity: 0.6;
	}

	/* ---------- Modo voz ---------- */
	#voice-btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		border: 1.5px solid #cfd7e4;
		border-radius: 50%;
		background: #fff;
		color: var(--royal);
		cursor: pointer;
		transition:
			border-color 0.15s,
			background 0.15s;
	}
	#voice-btn:hover {
		border-color: var(--royal);
		background: #eef3fb;
	}
	#voice-btn:disabled {
		opacity: 0.6;
	}
	#voice-btn svg,
	#voice-orb svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}
	#voice-bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		/* Hueco para el halo del micro, que crece con la voz. */
		padding-left: 0.5rem;
	}
	#voice-bar[hidden] {
		display: none;
	}
	#voice-orb {
		--level: 0;
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		flex: none;
		width: 3.4rem;
		height: 3.4rem;
		border: 0;
		border-radius: 50%;
		background: var(--navy);
		color: var(--gold);
		cursor: pointer;
	}
	#voice-orb svg {
		position: relative;
		width: 1.35rem;
		height: 1.35rem;
	}
	.orb-ring {
		position: absolute;
		z-index: -1;
		inset: 0;
		border-radius: 50%;
		background: rgb(237 187 0 / 35%);
		transform: scale(calc(1 + var(--level) * 0.55));
		transition: transform 0.08s linear;
	}
	#voice-bar[data-state='hearing'] #voice-orb {
		background: var(--grana);
		color: #fff;
	}
	#voice-bar[data-state='hearing'] .orb-ring {
		background: rgb(165 0 68 / 28%);
	}
	#voice-bar[data-state='loading'] .orb-ring,
	#voice-bar[data-state='transcribing'] .orb-ring,
	#voice-bar[data-state='busy'] .orb-ring {
		transform: scale(1.15);
		animation: cn-pulse 0.7s ease-in-out infinite alternate;
	}
	#voice-bar[data-state='speaking'] #voice-orb {
		background: var(--gold);
		color: var(--navy);
	}
	#voice-bar[data-state='speaking'] .orb-ring {
		animation: cn-speak 1.1s ease-out infinite;
	}
	.voice-copy {
		flex: 1;
		min-width: 0;
	}
	.voice-copy p {
		margin: 0;
		line-height: 1.25;
	}
	#voice-title {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.05rem;
		text-transform: uppercase;
		color: var(--navy);
	}
	#voice-sub {
		font-size: 0.75rem;
		color: var(--soft);
	}
	#voice-progress {
		height: 4px;
		margin-top: 0.4rem;
		border-radius: 999px;
		background: var(--line);
		overflow: hidden;
	}
	#voice-progress i {
		display: block;
		width: 0;
		height: 100%;
		background: var(--royal);
		transition: width 0.2s;
	}
	#voice-exit {
		flex: none;
		padding: 0.4rem 0.75rem;
		border: 1px solid #cfd9ea;
		border-radius: 999px;
		background: #fff;
		color: var(--royal);
		font: inherit;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
	}
	#voice-exit:hover {
		border-color: var(--royal);
	}
	:global(.cn-voice) {
		display: grid;
		justify-items: end;
		gap: 0.35rem;
		max-width: 86%;
	}
	:global(.cn-voice .cn-bubble) {
		max-width: 100%;
	}
	:global(.cn-bubble.user.live) {
		background: #fff;
		color: var(--royal);
		box-shadow: inset 0 0 0 1.5px var(--royal);
	}
	:global(.cn-bubble.user.live)::after {
		content: '';
		display: inline-block;
		width: 2px;
		height: 1em;
		margin-left: 2px;
		vertical-align: -0.15em;
		background: currentColor;
		animation: cn-pulse 0.5s steps(2) infinite;
	}
	:global(.cn-meta) {
		font-size: 0.68rem;
		color: #94a3b8;
		font-variant-numeric: tabular-nums;
	}
	:global(.cn-hints) {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.3rem;
	}
	:global(.cn-hints:empty) {
		display: none;
	}
	:global(.cn-hint) {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		background: #fff;
		box-shadow: inset 0 0 0 1px #cfd9ea;
		color: var(--navy);
		font-size: 0.72rem;
		font-weight: 700;
		animation: cn-pop 0.2s ease-out;
	}
	:global(.cn-hint.total) {
		background: var(--gold);
		box-shadow: none;
	}
	.zone[data-hint='true'] {
		stroke: var(--grana);
		stroke-width: 4;
		animation: cn-pulse 0.6s ease-in-out infinite alternate;
	}
	/* ---------- En vivo (GPT-Live) ---------- */
	#live-btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		border: 0;
		border-radius: 50%;
		background: var(--navy);
		color: var(--gold);
		cursor: pointer;
		transition: background 0.15s;
	}
	#live-btn:hover {
		background: var(--royal);
	}
	#live-btn:disabled {
		opacity: 0.6;
	}
	#live-btn svg,
	#live-controls svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.panel {
		transition:
			width 0.3s ease,
			height 0.3s ease,
			background 0.3s ease;
	}
	.panel.live {
		width: min(27rem, calc(100vw - 2rem));
		height: min(44rem, calc(100dvh - 7.5rem));
		background:
			radial-gradient(120% 60% at 50% 0%, rgb(0 77 152 / 55%), transparent 70%),
			radial-gradient(90% 50% at 50% 100%, rgb(165 0 68 / 35%), transparent 70%),
			#0a1540;
		color: #fff;
	}
	.panel.live .panel-head {
		background: transparent;
	}
	.panel.live #chat-log {
		background: transparent;
		mask-image: linear-gradient(to bottom, transparent, #000 2.5rem);
	}
	.panel.live .panel-foot {
		border-top-color: rgb(255 255 255 / 10%);
		background: transparent;
	}
	#live-stage {
		--agent: 0;
		--user: 0;
		display: grid;
		justify-items: center;
		gap: 0.2rem;
		padding: 0.6rem 1rem 0.4rem;
	}
	#live-stage[hidden] {
		display: none;
	}
	.live-orb {
		position: relative;
		display: grid;
		place-items: center;
		width: 9.5rem;
		height: 9.5rem;
		margin-bottom: 0.4rem;
	}
	.live-orb > span {
		position: absolute;
		border-radius: 50%;
	}
	.live-wave {
		inset: 1.6rem;
		border: 2px solid rgb(237 187 0 / 70%);
		opacity: calc(0.15 + var(--agent) * 0.85);
		transition:
			transform 0.06s linear,
			opacity 0.1s linear;
	}
	.live-wave.w1 {
		transform: scale(calc(1 + var(--agent) * 0.22));
	}
	.live-wave.w2 {
		border-color: rgb(237 187 0 / 40%);
		transform: scale(calc(1.05 + var(--agent) * 0.42));
	}
	.live-wave.w3 {
		border-color: rgb(237 187 0 / 20%);
		transform: scale(calc(1.1 + var(--agent) * 0.62));
	}
	.live-user {
		inset: 1.2rem;
		background: radial-gradient(circle, rgb(165 0 68 / 0%) 55%, rgb(165 0 68 / 55%) 70%, rgb(165 0 68 / 0%) 72%);
		opacity: var(--user);
		transform: scale(calc(1 + var(--user) * 0.35));
		transition: transform 0.06s linear;
	}
	.live-core {
		display: grid;
		place-items: center;
		inset: 2rem;
		background: radial-gradient(circle at 35% 30%, #2f6fd1, var(--royal) 45%, var(--grana) 100%);
		box-shadow:
			0 0 calc(18px + var(--agent) * 40px) rgb(237 187 0 / calc(0.25 + var(--agent) * 0.5)),
			inset 0 -8px 18px rgb(0 0 0 / 30%);
		transform: scale(calc(1 + var(--agent) * 0.07));
		transition: transform 0.06s linear;
	}
	.live-core img {
		width: 46%;
		height: auto;
		filter: drop-shadow(0 2px 6px rgb(0 0 0 / 35%));
	}
	/* El backend (gpt-6-luna) está trabajando: aro que gira alrededor del núcleo. */
	.live-core::before {
		content: '';
		position: absolute;
		inset: -7px;
		border-radius: 50%;
		background: conic-gradient(from 0deg, transparent 0 60%, var(--gold) 85%, transparent 100%);
		mask: radial-gradient(circle, transparent 64%, #000 66%);
		opacity: 0;
		transition: opacity 0.2s;
	}
	#live-stage[data-backend='true'] .live-core::before {
		opacity: 1;
		animation: live-spin 1s linear infinite;
	}
	#live-stage[data-state='connecting'] .live-core,
	#live-stage[data-state='listening'] .live-core {
		animation: live-breathe 2.4s ease-in-out infinite;
	}
	#live-title {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.35rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	#live-sub {
		margin: 0;
		font-size: 0.75rem;
		color: #aab6d3;
		text-align: center;
	}
	#live-controls {
		display: flex;
		justify-content: center;
		gap: 0.6rem;
	}
	#live-controls[hidden] {
		display: none;
	}
	#live-controls button {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		height: 2.8rem;
		padding: 0 1.2rem;
		border: 1.5px solid rgb(255 255 255 / 30%);
		border-radius: 999px;
		background: rgb(255 255 255 / 6%);
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	#live-controls button:hover {
		background: rgb(255 255 255 / 12%);
	}
	#live-mute[aria-pressed='true'] {
		border-color: var(--gold);
		color: var(--gold);
	}
	#live-end {
		border-color: transparent !important;
		background: #dc2626 !important;
	}
	#live-end:hover {
		background: #b91c1c !important;
	}
	:global(.panel.live .cn-bubble) {
		font-size: 1rem;
	}
	:global(.panel.live .cn-bubble.agent) {
		padding: 0.2rem 0.1rem;
		background: transparent;
		box-shadow: none;
		color: #fff;
		font-size: 1.08rem;
		line-height: 1.4;
	}
	:global(.panel.live .cn-bubble.user),
	:global(.panel.live .cn-bubble.user.live) {
		background: rgb(255 255 255 / 12%);
		box-shadow: none;
		color: #fff;
	}
	:global(.panel.live .cn-bubble.agent.speaking)::after {
		content: '';
		display: inline-block;
		width: 0.45em;
		height: 0.45em;
		margin-left: 0.3em;
		border-radius: 50%;
		background: var(--gold);
		animation: cn-pulse 0.5s ease-in-out infinite alternate;
	}
	:global(.panel.live .cn-chip) {
		border-color: rgb(255 255 255 / 15%);
		background: rgb(255 255 255 / 6%);
		color: #fff;
	}
	:global(.panel.live .cn-chip-head) {
		background: rgb(255 255 255 / 8%);
		color: #c9d3e6;
	}
	:global(.panel.live .cn-chip-head strong) {
		color: var(--gold);
	}
	:global(.panel.live .cn-chip pre) {
		color: #86efac;
	}
	:global(.panel.live .cn-chip-result) {
