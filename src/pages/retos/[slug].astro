---
import Editor from '../../components/retos/Editor.astro';
import { configDelEditor, pasosDelReto } from '../../data/editor';
import { retos } from '../../data/retos';
import Base from '../../layouts/Base.astro';
import '../../styles/flujo.css';

export function getStaticPaths() {
  return retos.map((reto, index) => ({
    params: { slug: reto.slug },
    props: { reto, prev: retos[index - 1], next: retos[index + 1] },
  }));
}

const { reto, prev, next } = Astro.props;

// El enunciado se parte en el comentario <!-- editor -->: lo de antes va encima del editor y el resto, debajo
const [antes, despues = ''] = (await reto.html()).split('<!-- editor -->');
const config = reto.editor ? configDelEditor(reto.slug, reto.editor) : null;
---

<Base title={`Reto ${reto.bloque}: ${reto.title}`} description={reto.resumen}>
  <p class="label">
    <a href="/retos">Retos</a> / {reto.extra ? 'Extra' : `Bloque ${reto.bloque}`} · {reto.minutos} min · en el navegador
  </p>
  <h1>{reto.title}</h1>
  <p class="resumen muted">{reto.resumen}</p>

  <article class="prose">
    <Fragment set:html={antes} />
  </article>

  {config && <Editor config={config} pasos={pasosDelReto(reto.slug)} minutos={reto.minutos} />}

  <article class="prose">
    <Fragment set:html={despues} />
  </article>

  <nav class="pager" aria-label="Otros retos">
    {prev ? <a href={`/retos/${prev.slug}`}>← {prev.title}</a> : <span />}
    {next ? <a href={`/retos/${next.slug}`}>{next.title} →</a> : <a href="/slides">Slides →</a>}
  </nav>
</Base>

<style>
  h1 {
    font-size: clamp(2.25rem, 7vw, 3.75rem);
    margin-block: 0.6rem 1rem;
  }

  .resumen {
    font-family: var(--sans);
    max-width: 62ch;
    font-size: 1.08rem;
    line-height: 1.65;
    color: #9c9ca4;
    margin-bottom: 2.75rem;
  }

  .prose {
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text);
  }

  .prose :global(h2) {
    color: var(--fg);
    font-size: 1.7rem;
    margin-block: 3rem 1.1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    margin-block: 2.25rem 0.75rem;
    color: #ffd27a;
  }

  .prose :global(h3 code) {
    color: inherit;
    border-color: color-mix(in srgb, #ffd27a 30%, var(--line));
    background: color-mix(in srgb, #ffd27a 8%, var(--surface));
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    max-width: 66ch;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote),
  .prose :global(table) {
    margin-block: 0 1.2rem;
  }

  .prose :global(strong) {
    color: #e4e4e9;
    font-weight: 600;
  }

  .prose :global(em) {
    color: #d0d0d8;
  }

  .prose :global(:not(pre) > code) {
    font-size: 0.85em;
    color: #e5d2a8;
    background: #161514;
    border: 1px solid #2b2720;
    border-radius: 5px;
    padding: 0.12em 0.42em;
  }

  .prose :global(pre) {
    font-family: var(--mono);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45rem;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 0.85rem 1.15rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 70%, transparent);
    border-radius: 0 6px 6px 0;
    background: var(--surface);
    color: #9c9ca4;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--muted);
    font-weight: 400;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
</style>
