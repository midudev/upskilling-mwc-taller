---
import { retos } from '../../data/retos';
import Base from '../../layouts/Base.astro';
---

<Base title="Retos">
  <p class="label">Una tienda online, cuatro piezas</p>
  <h1>Retos</h1>
  <p class="intro muted">
    Cada reto tiene una carpeta <code>inicio</code> (el punto de partida, con los <code>TODO</code> marcados) y una
    carpeta <code>solucion</code>. La demo de cada reto tiene una pestaña <strong>Ver solución</strong> que la ejecuta sin
    arrancar nada más. Si te pierdes, copia la solución y sigue con el siguiente bloque.
  </p>

  <ol>
    {
      retos.map((reto) => (
        <li>
          <a href={`/retos/${reto.slug}`}>
            <span class="n">0{reto.bloque}</span>
            <div>
              <h2>
                {reto.title}
                {reto.extra && <small class="muted"> · extra</small>}
              </h2>
              <p class="muted">{reto.resumen}</p>
            </div>
            <span class="muted time">{reto.minutos} min</span>
          </a>
        </li>
      ))
    }
  </ol>

  <pre><code>retos/
├── 01-mcp-ui/     inicio/  solucion/  README.md
├── 02-webmcp/     inicio/  solucion/  README.md
├── 03-jev/        inicio/  solucion/  README.md
├── 04-ia-local/   inicio/  solucion/  README.md   ← la solución es la app completa
└── 05-runonweb/   inicio/  solucion/  README.md   ← extra: más IA en local con runonweb</code></pre>
</Base>

<style>
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-block: 0.5rem 1.25rem;
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 3rem;
  }

  ol {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  li a:hover {
    color: var(--fg);
  }

  li a:hover h2 {
    color: var(--accent);
  }

  .n {
    font-family: var(--pixel);
    font-size: 1.25rem;
    color: var(--accent);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .time {
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
