---
import { retos } from '../../data/retos';
import Base from '../../layouts/Base.astro';
---

<Base title="Retos">
  <p class="label">Una tienda online, cuatro piezas</p>
  <h1>Retos</h1>

  <ol>
    {
      retos.map((reto) => (
        <li>
          <a href={`/retos/${reto.slug}`}>
            <span class="n">0{reto.bloque}</span>
            <div>
              <h2>
                {reto.title}
                {reto.extra && <small class="muted"> · extra</small>}
              </h2>
              <p class="muted">{reto.resumen}</p>
            </div>
            <span class="muted time">
              <span class="hecho" data-completado={reto.slug} hidden>✓ hecho · </span>
              {reto.minutos} min
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<script>
  // El editor guarda en localStorage los retos que tienen todos los pasos en verde
  for (const $hecho of document.querySelectorAll<HTMLElement>('[data-completado]')) {
    $hecho.hidden = !localStorage.getItem(`reto:${$hecho.dataset.completado}:completado`);
  }
</script>

<style>
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-block: 0.5rem 2.5rem;
  }

  ol {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  li a:hover {
    color: var(--fg);
  }

  li a:hover h2 {
    color: var(--accent);
  }

  .n {
    font-family: var(--pixel);
    font-size: 1.25rem;
    color: var(--accent);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .time {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .hecho {
    color: #3fdc6f;
  }
</style>
