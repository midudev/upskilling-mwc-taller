---
import { Font } from 'astro:assets';
import { Code } from 'astro:components';
import PixelIcon from '../components/PixelIcon.astro';
import type { IconName } from '../components/pixel-icons';
import Slide from '../components/Slide.astro';
import { schedule } from '../data/agenda';
import '../styles/global.css';
import '../styles/slides.css';

const theme = 'css-variables';

// Los mismos iconos que en la portada de la web
const blockIcons: IconName[] = ['mcp-ui', 'webmcp', 'jev', 'ia-local'];

const agendaIcon = (item: (typeof schedule)[number]): IconName => {
  if (item.block) return blockIcons[item.block - 1];
  if (item.kind === 'intro') return 'flag';
  if (item.kind === 'descanso') return 'coffee';
  return item === schedule.at(-1) ? 'ask' : 'cart';
};
const B1 = 'Bloque 1 · MCP UI';
const B2 = 'Bloque 2 · WebMCP';
const B3 = 'Bloque 3 · Jev';
const B4 = 'Bloque 4 · IA local';

const mcpBasic = `server.registerTool(
  'ver_equipo',
  {
    description: 'Posición, últimos resultados y próximo partido de un equipo de LaLiga',
    inputSchema: z.object({
      equipo: z.string().describe('Nombre o apodo: "Barça", "Atleti"…'),
    }),
  },
  async ({ equipo }) => {
    const ficha = await verEquipo(equipo); // JavaScript normal: llama a la API
    return {
      content: [{ type: 'text', text: resumen(ficha) }], // texto para el modelo
    };
  },
);`;

const mcpServer = `registerAppTool(                 // antes: server.registerTool(
  server,
  'ver_equipo',
  {
    description: 'Posición, últimos resultados y próximo partido de un equipo de LaLiga',
    inputSchema: z.object({ equipo: z.string() }),
    _meta: { ui: { resourceUri: 'ui://laliga/vista.html' } },  // nuevo
  },
  async ({ equipo }) => {
    const ficha = await verEquipo(equipo);
    return {
      content: [{ type: 'text', text: resumen(ficha) }], // para el modelo
      structuredContent: { equipo: ficha },               // nuevo: para la vista
    };
  },
);`;

const mcpResource = `registerAppResource(
  server,
  'LaLiga',
  'ui://laliga/vista.html',
  {},
  async () => ({
    contents: [{
      uri: 'ui://laliga/vista.html',
      mimeType: RESOURCE_MIME_TYPE,   // text/html;profile=mcp-app
      text: await crearVista(),       // un único HTML con su CSS y su JS
      // el iframe solo carga lo que permitas: aquí, los escudos
      _meta: { ui: { csp: { resourceDomains: ['https://a.espncdn.com'] } } },
    }],
  }),
);`;

const mcpView = `import { App } from '@modelcontextprotocol/ext-apps';
const app = new App({ name: 'LaLiga', version: '1.0.0' });

// cliente → vista: llega el resultado de la herramienta
app.addEventListener('toolresult', ({ structuredContent }) => {
  pintar(structuredContent); // la tabla, la jornada o la ficha
});

// vista → servidor: clic en un equipo, sin pasar por el modelo
$tabla.addEventListener('click', async (evento) => {
  const { equipo } = evento.target.closest('[data-equipo]').dataset;
  const resultado = await app.callServerTool({ name: 'ver_equipo', arguments: { equipo } });
  pintar(resultado.structuredContent);
});

await app.connect();`;

const webmcpTool = `await document.modelContext.registerTool({
  name: 'anadir_al_carrito',
  description: 'Añade un producto al carrito. Devuelve el carrito y el total en euros.',
  inputSchema: {
    type: 'object',
    properties: {
      id: { type: 'string', description: 'Identificador del producto' },
      cantidad: { type: 'integer', minimum: 1 },
    },
    required: ['id'],
  },
  execute({ id, cantidad = 1 }) {
    return añadirAlCarrito(id, cantidad);
  },
});`;

const webmcpForm = `<form
  toolname="suscribir_ofertas"
  tooldescription="Suscribe un correo a los avisos de ofertas de una categoría"
>
  <input type="email" name="email" required
         toolparamdescription="Correo electrónico del usuario" />

  <select name="categoria" required>…</select>

  <button>Avísame</button>
</form>`;

const webmcpHints = `annotations: {
  readOnlyHint: true,           // solo lee, no cambia nada
  untrustedContentHint: true,   // devuelve texto de terceros (reseñas)
  consequentialHint: true,      // difícil de deshacer: pide confirmación
}`;

const jevRequest = `const respuesta = await fetch(\`\${API_URL}/api/jev\`, {
  method: 'POST',
  headers: { Authorization: \`Bearer \${TOKEN}\`, 'Content-Type': 'application/json' },
  body: JSON.stringify({
    state: { reseña: 'Llegó tarde y la caja estaba rota. No vuelvo a comprar.' },
    questions: {
      tema:    { type: 'choice', instructions: '¿De qué trata?',
                 criteria: { producto: null, envio: null, otro: null } },
      nota:    { type: 'score',  instructions: '¿Qué valoración le da?',
                 criteria: ['Mala', 'Regular', 'Buena'] },
      urgente: { type: 'noul',   instructions: '¿Hay que responder hoy?' },
    },
  }),
});`;

const jevResponse = `{
  "answers": {
    "tema":    { "choice": "envio", "confidence": 0.97,
                 "probabilities": { "producto": 0.02, "envio": 0.97, "otro": 0.01 } },
    "nota":    { "score": 0.1, "confidence": 0.9 },
    "urgente": { "noul": 0.84 }
  },
  "usage": { "input_tokens": 212, "output_tokens": 30 }
}`;

const jevCode = `const { answers } = await respuesta.json();

if (answers.urgente.noul > 0.8) avisarAlEquipo();

if (answers.tema.choice === 'envio') abrirIncidencia('logística');

estrellas = Math.round(answers.nota.score) + 1;`;

const localSummarizer = `const idioma = { expectedInputLanguages: ['es'], outputLanguage: 'es' };

if ((await Summarizer.availability(idioma)) !== 'unavailable') {
  const summarizer = await Summarizer.create({
    ...idioma,
    type: 'tldr',
    length: 'short',
    monitor(m) {
      m.addEventListener('downloadprogress', (e) => console.log(e.loaded));
    },
  });

  const article = document.querySelector('article').innerText;
  let summary = '';

  for await (const trozo of summarizer.summarizeStreaming(article)) {
    summary += trozo;
  }

  console.log(summary);
}`;

const localPrompt = `const sesion = await LanguageModel.create({
  initialPrompts: [{ role: 'system', content: 'Analizas reseñas de una tienda.' }],
});

const respuesta = await sesion.prompt('Este producto es una caca', {
  responseConstraint: {
    type: 'object',
    properties: {
      pros: { type: 'array', items: { type: 'string' } },
      contras: { type: 'array', items: { type: 'string' } },
    },
  },
});

const { pros, contras } = JSON.parse(respuesta);

console.log('Pros:', pros);
console.log('Contras:', contras);`;

const localWebgpu = `import { pipeline } from '@huggingface/transformers';

const generador = await pipeline(
  'text-generation',
  'onnx-community/Qwen3.5-0.8B-Text-ONNX',
  {
    device: navigator.gpu ? 'webgpu' : 'wasm',
    dtype: 'q4f16',                    // 470 MB que descarga el usuario
    progress_callback: mostrarProgreso,
  },
);

const salida = await generador(mensajes, { max_new_tokens: 120 });`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Lo primero del <head>: los preload de las fuentes arrancan antes que nada */}
    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-mono" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Slides · Webs listas con la IA</title>
  </head>
  <body>
    <main id="deck" class="deck" aria-live="polite">
      <!-- ─────────────── Apertura ─────────────── -->
      <Slide
        kind="image"
        src="/slides/portada.jpg"
        alt="Upskilling Day Lleida. 11:00h – 14:00h. Miguel Ángel Duran. Webs listas con la IA: MCP UI, WebMCP, Jev e IA local en el navegador."
      />

      <Slide kind="statement">
        <div class="split">
          <div>
            <p class="big">Hola, soy <span class="accent">midudev</span></p>
            <p class="sub">Miguel Ángel Durán · Desarrollador de software y divulgador de programación</p>
          </div>
          <img class="avatar" src="/slides/midudev-pixel.png" alt="Retrato de midudev en pixel art" width="64" height="64" />
        </div>
      </Slide>

      <Slide kind="statement">
        <p class="big">Los agentes de IA ya no solo conversan.</p>
        <p class="big"><span class="accent">Navegan</span>, usan <span class="accent">herramientas</span> y <span class="accent">actúan</span> en nombre del usuario.</p>
        <div class="icon-row">
          <PixelIcon name="browser" size={128} />
          <PixelIcon name="tool" size={128} />
          <PixelIcon name="cursor" size={128} />
        </div>
      </Slide>

      <Slide kind="statement">
        <div class="split">
          <p class="big">
            ¿Está tu web<br />preparada para<br />un usuario que<br /><span class="accent">no es una persona</span>?
          </p>
          <div class="not-human">
            <PixelIcon name="robot" size={384} class="hero blink" />
            {/* Le dimos la vuelta al captcha de siempre */}
            <p class="captcha">
              <span class="tick"><PixelIcon name="check" size={48} /></span>
              Soy un robot
            </p>
          </div>
        </div>
      </Slide>

      <Slide title="Hoy construimos una tienda… para agentes">
        <ol class="cards four">
          <li><div class="card-top"><span class="n">01</span><PixelIcon name="mcp-ui" size={80} /></div><h3>MCP UI</h3><p>El catálogo, como interfaz dentro del chat</p></li>
          <li><div class="card-top"><span class="n">02</span><PixelIcon name="webmcp" size={80} /></div><h3>WebMCP</h3><p>La web expone herramientas a los agentes del navegador</p></li>
          <li><div class="card-top"><span class="n">03</span><PixelIcon name="jev" size={80} /></div><h3>Jev</h3><p>Decisiones rápidas que el código usa tal cual</p></li>
          <li><div class="card-top"><span class="n">04</span><PixelIcon name="ia-local" size={80} /></div><h3>IA local</h3><p>Modelos que se ejecutan en el navegador</p></li>
        </ol>
        <p class="foot">Explicación → código en directo → reto guiado en el navegador. Así cuatro veces.</p>
      </Slide>

      <Slide title="Agenda">
        <ol class="agenda">
          {
            schedule.map((item) => (
              <li class={item.kind}>
                <PixelIcon name={agendaIcon(item)} size={48} />
                <span class="time">{item.start}</span>
                <span class="what">
                  {item.block && <span class="accent">{item.block} · </span>}
                  {item.title}
                </span>
                <span class="min">{item.minutes} min</span>
              </li>
            ))
          }
        </ol>
      </Slide>

      <Slide title="Antes de empezar">
        <div class="split">
          <ol class="steps">
            <li><span class="n">1</span><div><h3>Abre la web del taller</h3><p>Agenda, retos y documentación de las APIs</p></div></li>
            <li><span class="n">2</span><div><h3>Los retos, en el navegador</h3><p>Un editor en la página, el resultado al lado y pasos que se comprueban solos. Nada que instalar</p></div></li>
            <li><span class="n">3</span><div><h3>Tu token del taller</h3><p class="token">MIDULL</p></div></li>
          </ol>
          <figure class="qr">
            <img src="/slides/qr-taller.svg" alt="Código QR del repositorio del taller" width="29" height="29" />
            <figcaption><code>midu.link/taller</code></figcaption>
          </figure>
        </div>
      </Slide>

      <!-- ─────────────── Bloque 1 · MCP UI ─────────────── -->
      <Slide kind="section" label="Bloque 1 · 11:10">
        <div class="split">
          <div>
            <p class="num">01</p>
            <h2>MCP UI</h2>
            <p class="sub">Interfaces interactivas dentro del chat</p>
          </div>
          <PixelIcon name="mcp-ui" size={384} class="hero" />
        </div>
      </Slide>

      <Slide kind="statement" label={B1}>
        <p class="big">MCP: un idioma común entre la IA y <span class="accent">tu código</span>.</p>
        <p class="sub">Model Context Protocol. Un estándar abierto: escribes el servidor una vez y funciona en Claude, ChatGPT, VS Code, Cursor…</p>
        <div class="icon-row">
          <PixelIcon name="chat" size={128} />
          <PixelIcon name="arrows" size={96} />
          <PixelIcon name="server" size={128} />
        </div>
      </Slide>

      <Slide label={B1} title="Las piezas">
        <div class="flow chain">
          <div class="box"><PixelIcon name="chat" size={80} /><h3>Cliente</h3><p>Claude, ChatGPT, VS Code… con su modelo</p></div>
          <div class="arrow"><PixelIcon name="arrows" size={80} /><span>JSON-RPC</span></div>
          <div class="box hl"><PixelIcon name="server" size={80} /><h3>Servidor MCP</h3><p>Tu código</p></div>
          <div class="arrow"><PixelIcon name="arrows" size={80} /><span>fetch, SQL…</span></div>
          <div class="box"><PixelIcon name="cloud" size={80} /><h3>Tus datos</h3><p>APIs, base de datos, ficheros</p></div>
        </div>
        <p class="foot">En local (stdio) o en remoto (HTTP). El modelo nunca toca tu API: solo usa lo que el servidor le ofrece.</p>
      </Slide>

      <Slide label={B1} title="Qué puede ofrecer un servidor">
        <ul class="cards three">
          <li><div class="card-top"><span class="n">decide el modelo</span><PixelIcon name="tool" size={80} /></div><h3>Tools</h3><p>Acciones que el modelo ejecuta cuando las necesita</p><p class="eg"><code>ver_equipo("Barça")</code></p></li>
          <li><div class="card-top"><span class="n">decide la app</span><PixelIcon name="doc" size={80} /></div><h3>Resources</h3><p>Datos que el cliente lee y añade al contexto</p><p class="eg"><code>ui://laliga/vista.html</code></p></li>
          <li><div class="card-top"><span class="n">decide el usuario</span><PixelIcon name="terminal" size={80} /></div><h3>Prompts</h3><p>Plantillas que el usuario elige, como un comando</p><p class="eg"><code>/resumen-jornada</code></p></li>
        </ul>
        <p class="foot">Hoy, sobre todo tools… y un resource muy especial: <span class="accent">ui://</span></p>
      </Slide>

      <Slide label={B1} title="Qué pasa cuando preguntas">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="doc" size={80} /><div><h3>El cliente pide las herramientas</h3><p><code>tools/list</code>: nombre, descripción y esquema de cada una</p></div></li>
          <li><span class="n">2</span><PixelIcon name="chat" size={80} /><div><h3>El usuario pregunta</h3><p>«¿Cómo le fue al Barça en el último partido?»</p></div></li>
          <li><span class="n">3</span><PixelIcon name="robot" size={80} class="blink" /><div><h3>El modelo elige herramienta y argumentos</h3><p><code>tools/call</code> → <code>ver_equipo({'{'} equipo: "Barça" {'}'})</code></p></div></li>
          <li><span class="n">4</span><PixelIcon name="server" size={80} /><div><h3>Tu código responde</h3><p>El servidor llama a la API y el modelo redacta con el resultado</p></div></li>
        </ol>
        <p class="foot">El modelo decide solo con el nombre y la descripción.</p>
      </Slide>

      <Slide label={B1} title="Un servidor MCP: una herramienta">
        <Code code={mcpBasic} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="En directo: LaLiga por MCP">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="tool" size={80} /><div><h3>Tres herramientas</h3><p><code>ver_clasificacion</code> · <code>ver_resultados</code> · <code>ver_equipo</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="trophy" size={80} /><div><h3>Datos reales</h3><p>La API pública de ESPN, sin clave</p></div></li>
          <li><span class="n">3</span><PixelIcon name="chat" size={80} /><div><h3>Lo conectamos al chat</h3><p>«¿Cómo le fue al Barça en el último partido?»</p></div></li>
        </ol>
        <p class="foot"><a class="demo" href="http://localhost:3101" target="_blank" rel="noopener">Abrir la demo ↗</a>directo/liga/1-mcp · npm run dev</p>
      </Slide>

      <Slide kind="statement" label={B1}>
        <div class="split">
          <div>
            <p class="big">El problema: una herramienta solo devuelve <span class="accent">texto</span>.</p>
            <p class="sub">Veinte equipos en una tabla de markdown. Sin escudos, sin colores, sin poder tocar nada.</p>
          </div>
          <PixelIcon name="doc" size={320} class="hero" />
        </div>
      </Slide>

      <Slide label={B1} title="MCP Apps: la herramienta trae su interfaz">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="doc" size={80} /><div><h3>La herramienta declara una vista</h3><p><code>_meta.ui.resourceUri = "ui://laliga/vista.html"</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="robot" size={80} /><div><h3>El modelo llama a la herramienta</h3><p>Texto para el modelo, datos para la vista</p></div></li>
          <li><span class="n">3</span><PixelIcon name="browser" size={80} /><div><h3>El cliente pinta el HTML</h3><p>En un iframe aislado, dentro de la conversación</p></div></li>
          <li><span class="n">4</span><PixelIcon name="arrows" size={80} /><div><h3>Hablan en los dos sentidos</h3><p>La vista recibe resultados y puede llamar a otras herramientas</p></div></li>
        </ol>
      </Slide>

      <Slide label={B1} title="Servidor: una herramienta con interfaz">
        <Code code={mcpServer} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="Servidor: el recurso <span class='accent'>ui://</span>">
        <Code code={mcpResource} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="Vista: el JavaScript del iframe">
        <Code code={mcpView} lang="js" theme={theme} />
      </Slide>

      <Slide label={B1} title="En directo: LaLiga con interfaz">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="tool" size={80} /><div><h3>Las mismas herramientas</h3><p><code>registerAppTool</code> + <code>ui://laliga/vista.html</code></p></div></li>
          <li><span class="n">2</span><PixelIcon name="mcp-ui" size={80} /><div><h3>Datos para la vista</h3><p>Tabla, resultados y ficha de equipo con escudos</p></div></li>
          <li><span class="n">3</span><PixelIcon name="cursor" size={80} /><div><h3>La vista llama al servidor</h3><p>Clic en un equipo → <code>ver_equipo</code>, sin pasar por el modelo</p></div></li>
        </ol>
        <p class="foot"><a class="demo" href="http://localhost:3102" target="_blank" rel="noopener">Abrir la demo ↗</a>directo/liga/2-mcp-ui · npm run dev</p>
      </Slide>

      <Slide kind="reto" label={B1}>
        <div class="split">
          <div>
            <p class="num">Reto 1</p>
            <h2>El catálogo dentro del chat</h2>
            <ul>
              <li>Convierte <code>buscar_productos</code> en una herramienta con interfaz</li>
              <li>Registra el recurso <code>ui://</code></li>
              <li>Haz que el botón «Añadir» llame al servidor</li>
            </ul>
            <p class="path"><a href="/retos/01-mcp-ui" target="_blank" rel="noopener">/retos/01-mcp-ui</a> · 10 min · en el navegador</p>
          </div>
          <PixelIcon name="mcp-ui" size={320} class="hero" />
        </div>
      </Slide>

      <!-- ─────────────── Bloque 2 · WebMCP ─────────────── -->
      <Slide kind="section" label="Bloque 2 · 11:50">
        <div class="split">
          <div>
            <p class="num">02</p>
            <h2>WebMCP</h2>
            <p class="sub">Tu web, como herramientas para los agentes del navegador</p>
          </div>
          <PixelIcon name="webmcp" size={384} class="hero" />
        </div>
      </Slide>

      <Slide label={B2} title="Así usa hoy tu web un agente">
        <ol class="steps">
          <li><span class="n">1</span><PixelIcon name="eye" size={80} /><div><h3>Hace una captura o lee el DOM</h3><p>Miles de tokens por cada paso</p></div></li>
          <li><span class="n">2</span><PixelIcon name="question" size={80} /><div><h3>Adivina qué botón pulsar</h3><p>«¿Será este icono el carrito?»</p></div></li>
          <li><span class="n">3</span><PixelIcon name="cursor" size={80} /><div><h3>Simula un clic y vuelve a mirar</h3><p>Lento, caro y frágil</p></div></li>
        </ol>
        <p class="foot">Cambias un <code>div</code> de sitio y el agente se pierde.</p>
      </Slide>

      <Slide kind="statement" label={B2}>
        <p class="big">WebMCP: la web <span class="accent">le dice</span> al agente qué puede hacer.</p>
        <p class="sub">Tu página registra herramientas con <code>document.modelContext</code>. El agente las llama: sin leer la pantalla, sin simular clics.</p>
        <div class="icon-row">
          <PixelIcon name="webmcp" size={128} />
          <PixelIcon name="arrows" size={96} />
          <PixelIcon name="robot" size={128} class="blink" />
        </div>
      </Slide>

      <Slide label={B2} title="MCP y WebMCP no compiten">
        <table class="two-lines">
          <thead><tr><th></th><th><span class="ico"><PixelIcon name="server" size={48} />MCP</span></th><th><span class="ico"><PixelIcon name="webmcp" size={48} />WebMCP</span></th></tr></thead>
          <tbody>
            <tr><td>Dónde vive</td><td>En un servidor</td><td>En la página, en el navegador</td></tr>
            <tr><td>Quién lo usa</td><td>Asistentes de chat e IDE</td><td>Agentes del navegador</td></tr>
            <tr><td>Sesión</td><td>La gestionas tú (OAuth…)</td><td>La del usuario: ya ha iniciado sesión</td></tr>
            <tr><td>Interfaz</td><td>La del chat (MCP Apps)</td><td>Tu web, a la vista del usuario</td></tr>
          </tbody>
        </table>
      </Slide>

      <Slide label={B2} title="API imperativa: <span class='accent'>registerTool</span>">
        <Code code={webmcpTool} lang="js" theme={theme} />
      </Slide>

      <Slide label={B2} title="API declarativa: un formulario es una herramienta">
        <Code code={webmcpForm} lang="html" theme={theme} />
        <p class="foot">El agente rellena, el usuario confirma. Con <code>toolautosubmit</code> se envía solo.</p>
